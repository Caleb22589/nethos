
# --- NETHOS -----------------------------------------------------------------
# Appended to archiso's releng package list by iso/build-iso.sh.
# Keep this in step with the pacman block in payload/install-nethos.sh.

# compositor: Hyprland is the NETHOS look (rounded corners, real blur)
hyprland
xdg-desktop-portal-hyprland
brightnessctl
wireplumber

# the shell renderer: WebKit + layer shell, not Chromium
webkitgtk-6.0
gtk4-layer-shell
python-gobject
python-dbus

# compositor and session
sway
swaybg
swayidle
swaylock
xorg-xwayland
wl-clipboard
polkit

# the shell renderer
chromium

# graphics: no GPU is assumed, llvmpipe does the work
mesa

# nethosd and tooling
python
curl
git

# networking. NetworkManager on its own cannot do Wi-Fi: it needs a supplicant
# backend, and without one a laptop with no ethernet port has no way online at
# all. iwd also provides iwctl, which is what the Arch install guide tells you
# to use, so people reasonably expect it to exist after install.
networkmanager
wpa_supplicant
iwd
usbmuxd            # iPhone USB tethering
modemmanager       # USB LTE dongles

# icon themes, so the launcher can show real application icons
hicolor-icon-theme
adwaita-icon-theme
papirus-icon-theme

# terminal and everyday apps
foot
thunar
mousepad
imv
htop
xdg-utils

# fonts the shell and apps ask for by name
ttf-dejavu
ttf-jetbrains-mono
noto-fonts
noto-fonts-emoji

# needed by nethos-install when putting NETHOS on a real disk
arch-install-scripts
gptfdisk
dosfstools
e2fsprogs
grub
efibootmgr
