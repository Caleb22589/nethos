# NETHOS compositor configuration.
#
# The hybrid model: sway does the real window management, and the NETHOS shell
# (a Chromium app window running local HTML) is pinned to the top of the screen
# as the panel. Native Wayland/X11 apps open as ordinary managed windows and
# are reported to the shell through nethosd.

set $mod Mod4
set $term foot

### appearance -------------------------------------------------------------

font pango:Nunito 10

# colours match shell/style.css so borders and panel read as one system
#                       border   bg       text     indicator child_border
client.focused          #3ddbd9  #131822  #d7dee9  #3ddbd9   #3ddbd9
client.focused_inactive #232b3b  #131822  #7c8798  #232b3b   #232b3b
client.unfocused        #232b3b  #0b0e14  #7c8798  #232b3b   #232b3b
client.urgent           #f7a072  #131822  #f7a072  #f7a072   #f7a072

default_border pixel 2
gaps inner 6
# reserve the top strip for the panel so tiled windows are never covered
gaps top 44

# swaybg draws a full-screen surface on the *background* layer, and the NETHOS
# desktop used to sit on that same layer. Two full-screen surfaces on one layer
# stack by creation order, and exec_always re-creates swaybg's on every reload
# -- putting it over the desktop, where it silently ate every click aimed at a
# widget. Verified with a pointerdown probe: panel and dock received events,
# desktop received none.
#
# The desktop is on the bottom layer now, above this. swaybg stays as the thing
# behind it, so a failed desktop surface still gives a coloured screen rather
# than a black one.
exec_always swaybg -c "#0b0e14"

### the shell ---------------------------------------------------------------

# nethos-session starts nethosd, waits for it to answer, then opens the panel
exec nethos-session

# Chromium ignores --class in --app mode and derives its own app_id from the
# URL, e.g. "chrome-127.0.0.1__panel.html-Default". sway matches app_id as a
# regex, so key off the page name — that part is stable.

# Sizing is done with Chromium's own --window-size (see nethos-session): a
# Wayland client picks its own size and ignores the compositor's suggestion, so
# `resize set` here would just be undone a moment later. Position still has to
# come from sway, and it must be `move absolute position` — plain `move
# position` is workspace-relative and lands below the reserved top gap.

# The panel: pinned to the very top, on every workspace.
for_window [app_id="^chrome-.*panel\.html.*$"] \
    floating enable, sticky enable, border none, \
    move absolute position 0 0

# The launcher is opened once at session start and parked in the scratchpad;
# toggling it is then `scratchpad show`, a compositor operation, instead of a
# cold Chromium start. That is the difference between instant and seconds.
for_window [app_id="^chrome-.*menu\.html.*$"] \
    floating enable, sticky enable, border none, \
    move scratchpad

# NETHOS app windows are placed by nethosd from each app's manifest (window vs
# widget), which sway's own rules cannot read. Only the fallback border here.
for_window [app_id="^chrome-.*__apps_.*$"] border pixel 2

# Chromium's own browsing windows should behave like normal apps.
for_window [app_id="^chromium$"] border pixel 2

### keys --------------------------------------------------------------------

bindsym $mod+Return exec $term
bindsym $mod+d exec nethos-menu-toggle
bindsym $mod+space exec nethos-menu-toggle
bindsym $mod+q kill
# Also mod+w, because that is the muscle memory. Deliberately NOT Ctrl+W:
# inside a browser Ctrl+W closes a tab, and a window manager that steals it
# closes the whole window when you meant to close one tab.
bindsym $mod+w kill

# Development: reload the shell, or the shell and the daemon together.
bindsym $mod+Shift+r exec nethos-reload
bindsym $mod+Ctrl+Shift+r exec nethos-reload --daemon
bindsym $mod+Shift+e exec swaynag -t warning -m 'Log out of NETHOS?' \
    -B 'Log out' 'swaymsg exit'

floating_modifier $mod normal

# Windows float, and snap where you put them.
#
# sway tiles by default, which is right for a tiling window manager and wrong
# for this. A desktop that rearranges everything the moment a window opens is
# deciding the layout for you; snapping proposes one and lets you refuse. Every
# window opens floating, and the mod+arrow keys snap rather than change focus.
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
for_window [app_id="^chrome-.*(panel|dock|menu|desktop)\.html.*$"] floating enable

# Snap: half screen by edge, quarter by corner, maximise up, restore down.
# Matches what Windows does with the same keys, because that is what hands
# already know.
set $snap_l resize set 50ppt 100ppt, move position 0 0
set $snap_r resize set 50ppt 100ppt, move position 50ppt 0
set $snap_u fullscreen disable, resize set 100ppt 100ppt, move position 0 0
set $snap_d resize set 60ppt 60ppt, move position center

bindsym $mod+Left  floating enable, $snap_l
bindsym $mod+Right floating enable, $snap_r
bindsym $mod+Up    floating enable, $snap_u
bindsym $mod+Down  floating enable, $snap_d

bindsym $mod+Ctrl+Left  floating enable, resize set 50ppt 50ppt, move position 0 0
bindsym $mod+Ctrl+Right floating enable, resize set 50ppt 50ppt, move position 50ppt 0
bindsym $mod+Shift+Ctrl+Left  floating enable, resize set 50ppt 50ppt, move position 0 50ppt
bindsym $mod+Shift+Ctrl+Right floating enable, resize set 50ppt 50ppt, move position 50ppt 50ppt

# Focus moves with the alt-style keys, since the arrows now snap.
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+v split vertical
bindsym $mod+b split horizontal

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

mode "resize" {
    bindsym Left  resize shrink width 10px
    bindsym Right resize grow width 10px
    bindsym Up    resize shrink height 10px
    bindsym Down  resize grow height 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### input/output ------------------------------------------------------------

input type:keyboard {
    xkb_options terminate:ctrl_alt_bksp
}

output * bg "#0b0e14" solid_color

include /etc/sway/config.d/*
