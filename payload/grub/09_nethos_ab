#!/bin/sh
# GRUB entries for both slots, and the counter that makes switching safe.
#
# Generated into grub.cfg by grub-mkconfig. The logic below runs *in GRUB*,
# not here: this script only emits it.
#
# nethos_slot      which slot to boot
# nethos_try       attempts remaining before giving up on it
# nethos_last_good the slot that was working before the switch
#
# Every attempt decrements the counter and saves it before booting, so a
# system that hangs or panics still spends an attempt. Only a system that
# reaches its own userland runs `nethos-ab mark-good`, which zeroes the
# counter. Three failures and GRUB boots the last good slot instead.
#
# Without the decrement-before-boot this is worse than nothing: a bootloader
# that flips slots but never counts will ping-pong between two broken systems
# forever, which is the failure docs/ABUPDATE.md warns about.
set -e

. /usr/share/grub/grub-mkconfig_lib 2>/dev/null || true

# Extra kernel parameters, in a file rather than in this script, so changing
# them does not mean editing a generator -- and so a machine can differ from
# the default without carrying a patch.
#
# preempt=full is the default because it is free here: CONFIG_PREEMPT_DYNAMIC
# is set, so the preemption model is chosen at boot rather than compiled in,
# and full is what a "lowlatency" kernel gives you. Debian boots
# PREEMPT_VOLUNTARY, which is tuned for throughput on servers.
#
# What is NOT here, because it cannot be: CONFIG_HZ. Debian builds 250, the
# tuned distributions build 1000, and that is compile-time. Same for the
# scheduler patch sets. Those need a kernel built, which is what the idle slot
# is for.
CMDLINE_FILE=/etc/nethos/cmdline
NETHOS_CMDLINE="preempt=full"
[ -r "$CMDLINE_FILE" ] && NETHOS_CMDLINE=$(grep -v '^#' "$CMDLINE_FILE" | tr '\n' ' ')

# Which kernel each slot boots, recorded on the ESP because the ESP is the one
# thing both slots share.
#
# This has to be per-slot or the whole scheme is a lie: /boot is shared, so
# installing a kernel puts it where both slots can see it, and an entry that
# simply took the newest would point *both* slots at a kernel only one of them
# was meant to try. The first kernel that failed to boot would then take the
# fallback with it.
KERNELS=/boot/nethos-kernels.conf
newest=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -1)
[ -n "$newest" ] || exit 0
newest=$(basename "$newest"); newest=${newest#vmlinuz-}

kver_for() {   # slot letter -> kernel version, falling back to the newest
    v=""
    [ -r "$KERNELS" ] && v=$(sed -n "s/^$1=//p" "$KERNELS" | tail -1)
    [ -n "$v" ] && [ -e "/boot/vmlinuz-$v" ] && { echo "$v"; return; }
    echo "$newest"
}
KVER_A=$(kver_for A)
KVER_B=$(kver_for B)

# A real-time kernel, if one is installed. Same system, same root, same home
# -- only the kernel differs, so this is a boot-time choice rather than a
# second installation. Keeping it out of the default is the point: PREEMPT_RT
# buys worst-case latency (measured here: 21us under full load against 3159us
# for the stock kernel) and costs a few percent of throughput, which is a good
# trade while recording and a bad one the rest of the time.
KVER_RT=$(ls -1 /boot/vmlinuz-*rt* 2>/dev/null | sort -V | tail -1)
[ -n "$KVER_RT" ] && { KVER_RT=$(basename "$KVER_RT"); KVER_RT=${KVER_RT#vmlinuz-}; }

cat <<EOF
# --- NETHOS A/B ---------------------------------------------------------
# One entry as far as anyone is concerned. Which slot it boots is an
# implementation detail of updating, not a choice to put in front of somebody
# turning their computer on -- so both entries carry the same name and the
# menu stays hidden. Hold SHIFT to see it when something has gone wrong.
#
# grub-reboot's next_entry is already handled by this point: Debian's own
# 00_header runs before this script and is grub-reboot's implementation --
# it reads next_entry, copies it into the default entry, clears next_entry,
# and marks that a one-shot choice was made. This file used to re-check
# next_entry itself and set the default entry again here, on the theory
# that it had to or its own logic below would overrule a one-shot choice --
# true in principle, but next_entry is already empty by the time this runs
# (00_header just cleared it), so that check was always false and execution
# always fell through to the normal nethos_slot logic below, clobbering the
# one-shot choice right back to the ordinary nethos-a/b entry. Confirmed on
# real hardware: the nethos-ab recovery subcommand armed next_entry
# correctly, grubenv showed it cleared after boot (proving 00_header ran),
# and the machine booted the normal desktop anyway.
#
# The variable to check instead is boot_once: 00_header sets it exactly
# when it has already made a one-shot choice, and it is runtime-only (never
# persisted to grubenv), so it is naturally unset again on the next boot
# without this file having to clear anything itself.
if [ -n "\$boot_once" ]; then
    set timeout=0
else

if [ -z "\$nethos_slot" ]; then set nethos_slot=A; fi
if [ -z "\$nethos_try" ];  then set nethos_try=0; fi
set recovery_boot=0

# Out of attempts: the slot we were trying never marked itself good.
if [ "\$nethos_try" = "0" -a -n "\$nethos_last_good" ]; then
    set nethos_slot="\$nethos_last_good"

    # nethos_try above only counts attempts of a slot being switched *to*.
    # Once it runs out and this forces nethos_slot back to nethos_last_good,
    # nothing was ever counting attempts of the fallback slot itself -- so a
    # fallback slot that also will not come up got retried forever with no
    # further decision ever made. nethos_try2 exists only for that case: it
    # starts counting the first time this branch is taken, and mark-good
    # clears it on every successful boot (see nethos-ab) -- a healthy machine
    # never accumulates it, only one stuck here boot after boot does.
    if [ -z "\$nethos_try2" ]; then set nethos_try2=3; fi
    if [ "\$nethos_try2" = "0" ]; then
        # The fallback slot has now failed three times running. Retrying it a
        # fourth time is not recovery, it is the same loop with extra steps --
        # go to the recovery environment on this same slot instead, since it
        # is the one most likely to actually still be intact.
        set recovery_boot=1
    fi
    if [ "\$nethos_try2" = "3" ]; then set nethos_try2=2; save_env nethos_try2; fi
    if [ "\$nethos_try2" = "2" ]; then set nethos_try2=1; save_env nethos_try2; fi
    if [ "\$nethos_try2" = "1" ]; then set nethos_try2=0; save_env nethos_try2; fi
fi

# Spend an attempt before booting, not after. A system that never gets far
# enough to run anything must still be counted as having been tried.
if [ "\$nethos_try" = "3" ]; then set nethos_try=2; save_env nethos_try; fi
if [ "\$nethos_try" = "2" ]; then set nethos_try=1; save_env nethos_try; fi
if [ "\$nethos_try" = "1" ]; then set nethos_try=0; save_env nethos_try; fi

if [ "\$recovery_boot" = "1" ]; then
    if [ "\$nethos_slot" = "B" ]; then set default=nethos-b-recovery; else set default=nethos-a-recovery; fi
else
    if [ "\$nethos_slot" = "B" ]; then set default=nethos-b; else set default=nethos-a; fi
fi
fi
set timeout_style=hidden
set timeout=0

menuentry 'NETHOS' --id nethos-a {
    # Two different roots, and conflating them is why this failed the first
    # time: GRUB reads the kernel from the ESP, which is a separate partition
    # shared by both slots, while root= on the command line is the slot the
    # kernel will mount. Searching for the slot here looked for a kernel
    # inside it and found nothing.
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_A root=LABEL=NETHOS_A rw quiet loglevel=3 $NETHOS_CMDLINE
EOF
[ -e "/boot/initrd.img-$KVER_A" ] && echo "    initrd /initrd.img-$KVER_A"
cat <<EOF
}

menuentry 'NETHOS' --id nethos-b {
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_B root=LABEL=NETHOS_B rw quiet loglevel=3 $NETHOS_CMDLINE
EOF
[ -e "/boot/initrd.img-$KVER_B" ] && echo "    initrd /initrd.img-$KVER_B"
cat <<'EOF'
}
EOF

# Recovery: same kernel, same slot, same root as the entry right above --
# nethos.recovery=1 is the only difference, and nethos-session (not GRUB or
# the kernel) is what actually reads it and shows the recovery page instead
# of the desktop. Named plainly rather than sharing 'NETHOS' with nethos-a/b:
# which slot boots is an implementation detail nobody needs to see, but
# whether this is a repair environment or the desktop is not.
cat <<EOF
menuentry 'NETHOS Recovery (slot A)' --id nethos-a-recovery {
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_A root=LABEL=NETHOS_A rw quiet loglevel=3 $NETHOS_CMDLINE nethos.recovery=1
EOF
[ -e "/boot/initrd.img-$KVER_A" ] && echo "    initrd /initrd.img-$KVER_A"
cat <<'EOF'
}
EOF
cat <<EOF
menuentry 'NETHOS Recovery (slot B)' --id nethos-b-recovery {
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_B root=LABEL=NETHOS_B rw quiet loglevel=3 $NETHOS_CMDLINE nethos.recovery=1
EOF
[ -e "/boot/initrd.img-$KVER_B" ] && echo "    initrd /initrd.img-$KVER_B"
cat <<'EOF'
}
EOF

# One extra entry per slot when a real-time kernel is present. Same root, same
# everything; only the kernel and initramfs differ.
if [ -n "$KVER_RT" ]; then
cat <<EOF

menuentry 'NETHOS (real-time kernel)' --id nethos-a-rt {
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_RT root=LABEL=NETHOS_A rw quiet loglevel=3 $NETHOS_CMDLINE
EOF
[ -e "/boot/initrd.img-$KVER_RT" ] && echo "    initrd /initrd.img-$KVER_RT"
cat <<EOF
}

menuentry 'NETHOS (real-time kernel)' --id nethos-b-rt {
    search --no-floppy --label --set=root NETHOSEFI
    linux  /vmlinuz-$KVER_RT root=LABEL=NETHOS_B rw quiet loglevel=3 $NETHOS_CMDLINE
EOF
[ -e "/boot/initrd.img-$KVER_RT" ] && echo "    initrd /initrd.img-$KVER_RT"
cat <<'EOF'
}
EOF
fi

cat <<'EOF'
# --- end NETHOS A/B -----------------------------------------------------
EOF
