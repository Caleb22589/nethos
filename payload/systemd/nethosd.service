[Unit]
# nethosd as a user service, so `systemctl --user restart nethosd` applies API
# changes in about a second instead of needing a reboot. sway imports its
# environment into the user manager before starting this (see sway/config),
# which is what gives swaymsg a working SWAYSOCK here.
Description=NETHOS shell bridge and app host
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/nethosd
Restart=on-failure
RestartSec=1
# Reload should feel instant; do not let a crash loop back off for long.
StartLimitBurst=10
StartLimitIntervalSec=30

[Install]
WantedBy=graphical-session.target
