[Unit]
Description=Apply a development payload from the ESP
# Must land before anything reads the files it replaces: the shell, nethosd and
# the compositor all live in the tree this rewrites.
After=local-fs.target
Before=multi-user.target getty@tty1.service
ConditionPathExists=/boot/nethos-dev/install-nethos.sh

[Service]
Type=oneshot
ExecStart=/usr/bin/nethos-devsync
# Always leave a hardware report on the ESP, whether or not a payload was
# applied. On a machine with no working network this is the only way the
# report gets off it, and it is what turns "no wifi" into a named chip and a
# named missing firmware file.
ExecStartPost=-/usr/bin/nethos-hwreport
RemainAfterExit=yes
# A bad payload must not stop the machine booting -- that is the whole point of
# being able to drop a fix on the stick.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
