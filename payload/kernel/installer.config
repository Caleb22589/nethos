# The installer kernel: enough to see, type, reach the network and write a disk.
#
# Not a trimmed system kernel -- a different thing with a different job. It has
# to boot on hardware nobody has tested, show a text installer, get online, and
# write the real system to an internal disk. Then it is never run again.
#
# Everything here is built in rather than modular. An installer that loads
# modules needs an initramfs that carries them, depmod, and a module for the
# thing it has not detected yet; built in, the kernel simply has the driver
# when it probes the bus. It costs a few megabytes of bzImage and removes a
# whole category of failure.
#
# Deliberately absent: amdgpu, i915, nouveau, sound, virtualisation, most
# filesystems. They are the bulk of a kernel's size and the installer needs
# none of them -- the system it installs has them all.

# --- console: whatever UEFI already set up, plus plain VGA text ---
#
# No GPU driver at all. SYSFB_SIMPLEFB turns the UEFI framebuffer into a device
# and SIMPLEDRM drives it; FB_EFI and FB_VESA cover firmware SYSFB misses. This
# is the one path that works on every x86 machine ever made, which is exactly
# what an installer needs.
CONFIG_FB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- input: a keyboard and a touchpad, or nobody can answer a question ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_SERIO_I8042=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
# The touchpad's interrupt arrives through the SoC GPIO controller; without
# these it enumerates and reports nothing, which reads as a dead trackpad.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y

# --- storage: the disk being installed to, and the stick booted from ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_NVME_CORE=y

# --- partitioning and filesystems: only what it writes or reads ---
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- wired network, including the USB-C adapter someone will plug in ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# --- wireless: an installer that cannot reach wifi is an offline installer ---
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
CONFIG_ATH9K=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_MT7921E=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_B43=y

# --- firmware comes from the initramfs, not from a filesystem yet mounted ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_EXTRA_FIRMWARE=""

# --- the rest: small, and the installer would not run without it ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- and what makes it small ---
CONFIG_DEBUG_INFO_NONE=y
CONFIG_KERNEL_ZSTD=y

# --- what defconfig brings that an installer must not carry ---
#
# These are the bulk of a kernel image. The installer draws text on the UEFI
# framebuffer and writes a disk; it has no use for a GPU, a sound card, a
# hypervisor or a filesystem it will never mount. The system it installs has
# all of them.
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_KVM is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_INFINIBAND is not set
# CONFIG_DRM_TTM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WIRELESS_HOTKEY is not set

# --- the I2C bus the touchpad actually hangs off ---
#
# PINCTRL_AMD delivers the interrupt and I2C_HID speaks the protocol, and
# between them there has to be a controller. On almost every laptop, AMD and
# Intel alike, that is a Synopsys DesignWare block. Without it there is no I2C
# bus for i2c-hid to attach to, nothing enumerates, and the touchpad is dead
# with every other piece of the chain present and correct -- which is exactly
# how an HP Envy x360 behaved here.
# I2C_DESIGNWARE_PLATFORM reads "depends on (ACPI && COMMON_CLK) || !ACPI".
# x86 has ACPI and defconfig does not enable COMMON_CLK, so the dependency
# fails and the option is dropped -- which is how the touchpad's bus went
# missing while every driver around it was present.
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_AMD_MP2=y
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_I2C_SMBUS=m
CONFIG_I2C_CHARDEV=y

# --- getting online without firmware, on anything ---
#
# There is no universal wifi firmware and there cannot be: every chip needs its
# own blob, and the complete set is about a gigabyte. What is universal is the
# firmware-free path -- ethernet, and a phone sharing its connection over USB.
# Once the machine is online by any of these it can fetch the exact firmware
# for the wifi chip it actually has.
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_IPHETH=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_ZAURUS=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_NET_SR9700=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_DM9601=y
CONFIG_USB_NET_ASIX=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_PEGASUS=y
CONFIG_USB_RTL8150=y
# Wired PCI parts that need no firmware either.
CONFIG_TIGON3=y
CONFIG_BNX2=y
CONFIG_SKY2=y
CONFIG_VIA_RHINE=y
CONFIG_8139TOO=y
CONFIG_ATL1C=y
CONFIG_R8169=y
