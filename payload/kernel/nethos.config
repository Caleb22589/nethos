# What a NETHOS kernel must have, on top of whatever base config is used.
#
# In the repository because it is part of the system, not part of a machine.
# A build should not depend on reaching some other computer to ask it what
# drivers it wants -- that made kernel builds fail when a laptop was asleep,
# which is a silly reason to be unable to compile.
#
# Applied with scripts/config after the base config, so it wins.

# --- storage: without these the installer cannot see a disk ---
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- input and USB: a machine you cannot type on is not installed ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m

# --- graphics: the shell is a browser, so this is not optional ---
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_I915=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- network, wired and not ---
CONFIG_E1000E=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K_PCI=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT7921E=m

# --- sound: PipeWire needs something underneath it ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m

# --- the desktop's own requirements ---
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_UINPUT=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y

# --- tuning: the CachyOS-style choices that are configuration ---
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_TCP_CONG_BBR=y
CONFIG_DEBUG_INFO_NONE=y
