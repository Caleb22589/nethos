# What a NETHOS kernel must have, on top of whatever base config is used.
#
# In the repository because it is part of the system, not part of a machine.
# A build should not depend on reaching some other computer to ask it what
# drivers it wants -- that made kernel builds fail when a laptop was asleep,
# which is a silly reason to be unable to compile.
#
# Applied with scripts/config after the base config, so it wins.

# --- storage: without these the installer cannot see a disk ---
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- input and USB: a machine you cannot type on is not installed ---
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m

# --- graphics: the shell is a browser, so this is not optional ---
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_I915=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Something has to create the framebuffer, and something has to draw text on it.
#
# SIMPLEDRM binds a "simple-framebuffer" platform device, and only SYSFB_SIMPLEFB
# creates one from what UEFI handed over. Without it SIMPLEDRM binds nothing;
# without FBDEV_EMULATION there is no fbcon on top of any DRM driver either. A
# kernel with neither boots perfectly and prints not one character, so the screen
# keeps whatever GRUB left on it -- "Loading initial ramdisk" forever, which
# looks exactly like a hang and is not one. FB_EFI is the older path, kept as a
# fallback for firmware that SYSFB does not pick up.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y

# --- network, wired and not ---
CONFIG_E1000E=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
# ATH10K_PCI and ATH11K_PCI depend on their parent driver being on first --
# without these two lines olddefconfig silently dropped both, which on a
# Qualcomm-equipped laptop is a machine with no wifi and no explanation.
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT7921E=m

# --- sound: PipeWire needs something underneath it ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m

# --- the desktop's own requirements ---
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# The default-compressor choice is only offered once its backend is built in.
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_INPUT_UINPUT=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y

# --- tuning: the CachyOS-style choices that are configuration ---
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_TCP_CONG_BBR=y
CONFIG_DEBUG_INFO_NONE=y

# --- namespaces: without these the desktop has no apps at all ---
#
# WebKitGTK sandboxes every web process with bubblewrap, and bubblewrap needs
# user namespaces. Without USER_NS every app dies before drawing anything:
#
#   bwrap: Creating new namespace failed, likely because the kernel does not
#          support user namespaces.
#   ERROR: Failed to fully launch dbus-proxy: Child process exited with code 1
#
# The shell is a browser, so this is not a sandboxing nicety -- it is the
# difference between a desktop and a blank screen. defconfig leaves it off and
# the distro config we used before had it on, which is why it appeared only
# after the switch to a lean base.
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# --- laptop input: a touchpad that never interrupts looks like a dead one ---
#
# On a modern laptop the I2C touchpad's interrupt arrives through the SoC's
# GPIO controller. Without its pinctrl driver the device enumerates, reports
# nothing, and the cursor sits still -- exactly what an HP Envy x360 did here.
# The pinctrl drivers need the subsystem itself, which defconfig leaves off --
# the same parent-symbol trap as ATH10K_PCI needing ATH10K.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_HID_MULTITOUCH=m
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_FOCALTECH=y

# --- USB networking: every USB-C dock and adapter is one of these ---
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m

# --- wifi: the family builds, the chip is a separate option ---
#
# RTW89=m without RTW89_8852BE=m produces no driver for the card in the
# machine. Same trap as ATH10K_PCI needing ATH10K. IWLDVM is the older Intel
# path -- a Latitude E7440's Centrino needs it and IWLMVM does not cover it.
CONFIG_IWLDVM=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m

# --- Apple hardware, for the MacBooks this is meant to run on ---
CONFIG_HID_APPLE=m
CONFIG_MOUSE_BCM5974=m
CONFIG_APPLE_GMUX=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_B43=m
CONFIG_SND_HDA_CODEC_CIRRUS=m

# --- the I2C bus the touchpad actually hangs off ---
#
# PINCTRL_AMD delivers the interrupt and I2C_HID speaks the protocol, and
# between them there has to be a controller. On almost every laptop, AMD and
# Intel alike, that is a Synopsys DesignWare block. Without it there is no I2C
# bus for i2c-hid to attach to, nothing enumerates, and the touchpad is dead
# with every other piece of the chain present and correct -- which is exactly
# how an HP Envy x360 behaved here.
# I2C_DESIGNWARE_PLATFORM reads "depends on (ACPI && COMMON_CLK) || !ACPI".
# x86 has ACPI and defconfig does not enable COMMON_CLK, so the dependency
# fails and the option is dropped -- which is how the touchpad's bus went
# missing while every driver around it was present.
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_AMD_MP2=m
CONFIG_I2C_I801=m
CONFIG_I2C_PIIX4=m
CONFIG_I2C_SMBUS=m
CONFIG_I2C_CHARDEV=m
