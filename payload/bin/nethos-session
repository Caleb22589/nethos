#!/bin/sh
# Bring up the NETHOS shell.
#
# Four layer-shell surfaces, all hosted by one nethos-view process:
#
#   desktop   the wallpaper, and the widgets that live on it
#   panel     top bar: launcher mark, windows, tray, clock
#   dock      bottom dock, auto-hiding
#   menu      the launcher, hidden until asked for
#
# They are layer surfaces rather than windows, so the compositor blurs behind
# them, reserves space for the panel, and never tiles them by accident.
set -eu

API="http://127.0.0.1:7777"

# Hand the compositor's environment to the user service manager, otherwise
# nethosd starts without WAYLAND_DISPLAY and cannot talk to the compositor.
systemctl --user import-environment \
    WAYLAND_DISPLAY SWAYSOCK HYPRLAND_INSTANCE_SIGNATURE \
    XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true

if ! systemctl --user restart nethosd.service 2>/dev/null; then
    if ! curl -sf -o /dev/null --max-time 2 "$API/api/status" 2>/dev/null; then
        /usr/bin/nethosd &
    fi
fi

# Wait for the compositor to have settled, not just to exist.
#
# Surfaces created in the first moments of a Wayfire session come up
# permanently one frame behind: what is drawn appears only after the *next*
# commit, so closing the launcher shows the launcher and opening the control
# centre shows what was there before it. Measured, on a cold boot: launcher
# region 0.0% of the screen with the launcher open and 77.8% after closing it
# -- the states inverted. Restarting the shell at any later point fixes it
# completely and permanently (83.6% open, 0.0% closed), which is what says the
# problem is when the surfaces are created rather than what they contain.
#
# The root cause is below us -- wlroots damage tracking against amdgpu, most
# likely, and nethos-session already carries a note about wlroots giving up on
# repaint scheduling when a page flip does not complete. This is not that fix.
# It is the cheap half: create the surfaces a few seconds later, once the
# compositor has finished bringing up outputs, and the bad state does not
# happen. Measured from the compositor's own start rather than slept blindly,
# so a fast machine waits less and this does not become a fixed tax on boot.
SETTLE=${NETHOS_SETTLE:-4}
SESSION_LOG="$HOME/.cache/nethos/session.log"
mkdir -p "$(dirname "$SESSION_LOG")" 2>/dev/null || true

# Find the compositor without pgrep. autostart runs with whatever PATH the
# compositor inherited, which is not the login shell's -- and when pgrep was
# not on it this whole block was skipped silently, so the wait never happened
# and a boot that was supposed to test the delay tested nothing. /proc is
# always there.
wf_pid=""
for c in /proc/[0-9]*/comm; do
    if [ -r "$c" ] && [ "$(cat "$c" 2>/dev/null)" = "wayfire" ]; then
        wf_pid=${c#/proc/}; wf_pid=${wf_pid%/comm}; break
    fi
done
printf '%s settle: wayfire pid=%s settle=%s\n' "$(date +%H:%M:%S)" "${wf_pid:-none}" "$SETTLE" >> "$SESSION_LOG" 2>/dev/null || true
if [ -n "$wf_pid" ] && [ -r "/proc/$wf_pid/stat" ]; then
    # Field 22 is starttime in clock ticks since boot.
    start_ticks=$(awk '{print $22}' "/proc/$wf_pid/stat" 2>/dev/null)
    hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
    now_s=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
    up_s=$(( now_s - start_ticks / hz ))
    printf '%s settle: compositor up %ss, waiting for %ss\n' \
        "$(date +%H:%M:%S)" "$up_s" "$SETTLE" >> "$SESSION_LOG" 2>/dev/null || true
    while [ "$up_s" -lt "$SETTLE" ]; do
        sleep 0.5
        now_s=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
        up_s=$(( now_s - start_ticks / hz ))
    done
    printf '%s settle: done, compositor up %ss\n' \
        "$(date +%H:%M:%S)" "$up_s" >> "$SESSION_LOG" 2>/dev/null || true
fi

# Wait for the API rather than racing it.
i=0
while [ "$i" -lt 150 ]; do
    curl -sf -o /dev/null "$API/api/status" && break
    i=$((i + 1))
    sleep 0.1
done

if [ "$i" -ge 150 ]; then
    notify-send "NETHOS" "nethosd failed to start" 2>/dev/null || true
    echo "nethosd did not come up; check: systemctl --user status nethosd" >&2
    exit 1
fi

# virtio_gpu's atomic KMS does not always deliver page-flip completion events.
# wlroots submits a frame, waits for a flip that never completes, and stops
# scheduling repaints -- so the desktop paints one partial frame and then
# freezes until an input event kicks it. That is the "white screen for twenty
# seconds", the buttons that do nothing, and the half-drawn dock: the surfaces
# are not slow, they are simply never asked to draw again. The legacy modeset
# path does not have the problem.
# Opt-in, because forcing it produced a black screen on virtio_gpu: the legacy
# path fixes the stuck flip on some hosts and fails to modeset at all on others.
#   NETHOS_NO_ATOMIC=1 nethos-session
[ "${NETHOS_NO_ATOMIC:-0}" = "1" ] && export WLR_DRM_NO_ATOMIC=1

# Try it for exactly one boot, and take it back automatically.
#
# The legacy modeset path is the documented fix for the fault described above
# -- wlroots giving up on repaint scheduling -- and that fault is what the
# ghost looks like: surfaces that draw only when something else forces the
# compositor to repaint. But the same note records it producing a black screen
# on other hardware, and a black screen you have to edit a config file to
# escape is a worse outcome than a ghost.
#
# So: a flag consumed before it is used. Set the file, reboot, and the next
# boot after that is normal whatever happened -- including the boot where you
# could not see anything to fix it with.
#
#   touch ~/.cache/nethos/try-no-atomic   # then reboot
#
NO_ATOMIC_ONCE="$HOME/.cache/nethos/try-no-atomic"
if [ -f "$NO_ATOMIC_ONCE" ]; then
    rm -f "$NO_ATOMIC_ONCE"
    export WLR_DRM_NO_ATOMIC=1
    printf '%s no-atomic: consumed the flag, WLR_DRM_NO_ATOMIC=1 for this boot\n' \
        "$(date +%H:%M:%S)" >> "$SESSION_LOG" 2>/dev/null || true
fi
true

# WebKit's compositing buffers are expensive without a GPU -- but with one they
# are how the work leaves the CPU. Disabling compositing on a machine that has
# virgl keeps the whole shell rendering in software and is the difference
# between a desktop that responds and one that does not.
# GPU compositing is off unless explicitly asked for.
#
# Verified on real hardware: `chromium` opened a blank window and logged
# "Frame latency is negative" from its display compositor, while
# `chromium --disable-gpu` rendered perfectly. WebKit fails the same way, and
# that is the frozen clock and the dead buttons -- the surfaces paint once and
# then never again. Thunar was fine throughout, because it has no GPU
# compositor of its own.
#
# This used to be keyed off the GL renderer, which was exactly backwards: on a
# machine with a real GPU the check passed and turned acceleration on, into the
# broken path. Correctness first; NETHOS_GPU_COMPOSITING=1 for anyone whose
# driver actually works.
# Update: that reasoning was built on a misdiagnosis. The frozen clock and the
# dead buttons were connection-pool exhaustion -- the shell held every
# connection WebKit would give a single origin open on /api/events, so nothing
# else could be fetched -- and that is fixed properly now, in nethos-view.
# Disabling compositing never addressed it and outlived the bug it was for.
#
# It also causes a bug of its own, which is worse because it is visible. With
# compositing off WebKit repaints only the damaged rectangle and assumes an
# opaque backdrop. On a transparent layer surface nothing ever clears what was
# there before, so the dock accumulates: every frame of the hover animation
# stays on screen, tooltips pile up on top of each other, and the dock "will
# not hide" because its last frame is simply never erased. Confirmed by
# screenshotting the running machine with and without it.
#
# So: composite on hardware that can, fall back where there is no render node
# (a VM with llvmpipe, where the accelerated path buys nothing anyway).
# NETHOS_GPU_COMPOSITING=0 forces the fallback; =1 forces acceleration.
# The renderer was already decided before the compositor started -- this runs
# inside it, and wlroots read WLR_RENDERER seconds ago. Re-deciding here is
# what made the first fix for the white screen do nothing at all: the log said
# "renderer=pixman" while wayfire had already built a GLES2 one.
#
# So this only inherits the decision, for the WebKit settings below that are
# still ours to make.
eval "$(nethos-gpu-env)"
printf '%s gpu: drm=%s renderer=%s\n' "$(date +%H:%M:%S)" \
    "${NETHOS_DRM_DRIVER:-none}" "$([ "${NETHOS_GPU:-0}" = 1 ] && echo gl || echo pixman)" \
    >> "$SESSION_LOG" 2>/dev/null || true

# GTK3 applications draw their own title bars by default, which is why Thunar
# and the terminal used to look like visitors from another desktop. GTK_CSD=0
# asks them to let the compositor decorate instead, so firedecor gives them the
# same rounded frame and the same three lights as everything else.
# GTK4 ignores it -- those apps keep their own header bars, and that is the
# remaining gap.
#
# Only under Wayfire, though -- firedecor is a Wayfire plugin. sway's own
# decoration is `border pixel`/`border normal`, and neither draws a close
# button; that has never been a sway feature (i3 does not have one either).
# Without this guard, GTK_CSD=0 under sway told every GTK3 app -- GIMP,
# Thunar -- to stop drawing its own header bar for a compositor that was
# never going to draw one back, leaving no title bar and no way to close
# except a keybind. foot and VLC are unaffected by this specific setting --
# neither is GTK3 -- but they have the same visible symptom for a different
# reason: `border pixel` genuinely has no title bar on any app, GTK or not.
[ -n "$wf_pid" ] && export GTK_CSD=0

# LIBGL_ALWAYS_SOFTWARE is *not* forced here. It used to be, on the assumption
# that a VM has no GPU -- but virtio_gpu is a real DRM device, and Mesa rejects
# the combination outright: "Not allowed to force software rendering when API
# explicitly selects a hardware device". EGL then fails for everything started
# from this session. Only honour it if the caller genuinely wants it.
[ -n "${LIBGL_ALWAYS_SOFTWARE:-}" ] && export LIBGL_ALWAYS_SOFTWARE

# The glass shell needs WebKit and gtk4-layer-shell. A files-only update
# installs new scripts without new packages, so check rather than assume --
# being left with no desktop at all is a much worse outcome than an old-looking
# one. Fall back to the previous Chromium panel if anything is missing.
shell_ready() {
    command -v nethos-view >/dev/null 2>&1 || return 1
    python3 - <<'PY' >/dev/null 2>&1 || return 1
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, WebKit, Gtk4LayerShell  # noqa: F401
PY
    return 0
}

if ! shell_ready; then
    echo "nethos: WebKit/layer-shell unavailable, falling back to the Chromium panel" >&2
    echo "nethos: run 'sudo nethos-update --packages' to get the glass shell" >&2
    WIDTH=1440
    exec chromium \
        --ozone-platform=wayland --enable-features=UseOzonePlatform \
        --disable-gpu --password-store=basic --no-first-run \
        --no-default-browser-check --process-per-site \
        --disable-site-isolation-trials --no-zygote \
        --app="$API/panel.html" \
        --window-size="${WIDTH},38" --window-position=0,0 \
        --user-data-dir="$HOME/.config/nethos-chromium"
fi

# First run: show the welcome once, and only once.
#
# Launched in the background rather than before the shell -- a welcome screen
# that appears before the desktop it describes has nothing to point at, and if
# it ever failed to start the machine would have no desktop at all.
#
# The flag is read with python -c rather than a heredoc: a heredoc nested
# inside a command substitution inside a subshell is three levels of quoting
# and it only has to be wrong once to take the whole session script with it.
nethos_first_run() {
    sleep 6
    seen=$(python3 -c 'import json,os,sys; p=os.path.expanduser("~/.config/nethos/settings.json"); sys.stdout.write("yes" if (os.path.exists(p) and json.load(open(p)).get("onboarded")) else "no")' 2>/dev/null || echo no)
    [ "$seen" = "no" ] || return 0
    curl -sf -X POST -H 'Content-Type: application/json' \
         -d '{"id":"welcome"}' "$API/api/launch" >/dev/null 2>&1 || true
}
nethos_first_run &

# No separate app-window host to warm here any more: the shell process
# started below (exec nethos-view ...) serves that role itself now, so app
# windows share its already-warm WebKit engine instead of a second one
# running alongside it purely to avoid a cold process per launch. Measured
# on real hardware: the shell and a separate apphost with one window open
# cost about the same, ~500-600MB each, almost entirely WebKit's own fixed
# baseline rather than anything proportional to what either one draws --
# running both was paying that baseline twice.
#
# nethosd's ensure_apphost() still spawns a standalone `nethos-view
# --apphost` as a fallback if the shell itself is not answering; that path
# is unchanged, just no longer the normal one.

# The panel is 360 tall, not 54. The bar itself is still 54 and the exclusive
# zone is still 46 -- the rest is transparent surface for menus to open into.
# A context menu on a 54px surface is clipped to 54px, which is what happened:
# right-clicking a task showed the first item and nothing else. The panel
# limits its own input region to the bar (initPanel/applyPanelRect), so the
# empty space below it does not eat clicks meant for windows.
#
# No comments inside the argument list below: a `\` splices the next line onto
# this command, so a `#` line in the middle comments out every argument after
# it. Doing exactly that silently reduced the shell to its desktop layer --
# no panel, no dock, no launcher, and no error anywhere.
exec nethos-view \
    "url=$API/splash.html,role=overlay,name=splash,exclusive=0" \
    "url=$API/desktop.html,role=widget,name=desktop,layer=bottom,anchor=top,exclusive=-1" \
    "url=$API/panel.html,role=panel,name=panel,height=360,anchor=top,exclusive=46" \
    "url=$API/dock.html,role=dock,name=dock,height=110,anchor=bottom,exclusive=0" \
    "url=$API/menu.html,role=overlay,name=menu,keyboard=on,exclusive=0"
