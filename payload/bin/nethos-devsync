#!/bin/sh
# Apply a payload dropped on the ESP, at boot, without rebuilding anything.
#
# The ESP is FAT, so macOS mounts it natively -- which means a fix can be
# copied onto the stick from the machine that wrote the image, with no Linux
# host, no loop mount and no image build. scripts/dev-push.sh puts it there;
# this applies it.
#
# Why this exists: a one-line change to the shell used to cost a kernel build
# and an emulated image build, about fifty minutes, because there was no way to
# get a file onto the machine. install-nethos.sh --files-only has always taken
# seconds; nothing carried the files to it.
#
# Only runs when the payload has actually changed, so an untouched stick costs
# one checksum at boot.
set -eu

DEV=/boot/nethos-dev
STAMP=/var/lib/nethos/devsync.stamp
LOG=/var/log/nethos-devsync.log

[ -f "$DEV/install-nethos.sh" ] || exit 0

# Hash the contents, not the metadata.
#
# Size and mtime looked cheaper and does not work: cp gives every file the same
# timestamp, FAT stores mtime to two seconds, and an edit made within that
# window is invisible -- which is exactly the edit-copy-boot loop this is for.
# Verified: touching a file did not change the metadata fingerprint at all.
# The payload is a few megabytes, so hashing it costs a fraction of a second
# once per boot.
fingerprint() {
    find "$DEV" -type f | LC_ALL=C sort | while IFS= read -r f; do
        printf '%s ' "$f"
        cksum < "$f"
    done | cksum
}

now=$(fingerprint)
mkdir -p "$(dirname "$STAMP")"
if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$now" ]; then
    exit 0
fi

# Installing a kernel here rather than rebuilding an image.
#
# A kernel change is five minutes to cross-compile and twenty-five to bake into
# an image, and the image build spends nearly all of that reinstalling 621
# Debian packages that did not change. Unpacking the tarball over the running
# root and regenerating the initramfs does the same job in about a minute.
#
# Only in place: this is the development path for a stick being iterated on.
# nethos-kernel install-tar is still the right tool for an installed system
# with slots, where a bad kernel has somewhere to fall back to.
install_kernel() {
    tgz="$DEV/kernel.tgz"
    [ -f "$tgz" ] || return 0
    echo "--- kernel: unpacking $(basename "$tgz") ---"
    tar xzf "$tgz" -C / || { echo "kernel: tar failed"; return 1; }
    kver=$(ls -1 /lib/modules 2>/dev/null | sort -V | tail -1)
    [ -n "$kver" ] && [ -e "/boot/vmlinuz-$kver" ] || {
        echo "kernel: no bootable kernel after unpack"; return 1; }
    echo "kernel: $kver"
    # targz-pkg ships the unstripped vmlinux; nothing boots from it and the ESP
    # is small.
    rm -f "/boot/vmlinux-$kver"
    depmod -a "$kver" || true
    if command -v update-initramfs >/dev/null 2>&1; then
        update-initramfs -c -k "$kver" || mkinitramfs -o "/boot/initrd.img-$kver" "$kver" || {
            echo "kernel: no initramfs -- refusing to leave it half installed"; return 1; }
    fi
    command -v grub-mkconfig >/dev/null 2>&1 && grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
    echo "kernel: installed, reboot to run it"
}

{
    echo "--- $(date -Is) applying $DEV ---"
    ok=1
    # FAT carries no execute bit, so the interpreter is named explicitly.
    sh "$DEV/install-nethos.sh" --files-only || { echo "payload FAILED"; ok=0; }
    install_kernel || { echo "kernel FAILED"; ok=0; }
    if [ "$ok" = 1 ]; then
        echo "applied"
        printf '%s' "$now" > "$STAMP"
    else
        echo "left the stamp alone so it retries next boot"
    fi
} >> "$LOG" 2>&1
