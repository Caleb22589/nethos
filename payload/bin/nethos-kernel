#!/bin/bash
# Install a kernel into the slot you are not running from.
#
#   nethos-kernel list                     kernels this machine could run
#   nethos-kernel current                  what each slot boots
#   nethos-kernel install <package>        into the idle slot, then switch
#   nethos-kernel build [options]          build a kernel from source
#   nethos-kernel repack [--out DIR]       repackage a built tree, stripped
#   nethos-kernel install-tar <file>       install a built kernel into the idle slot
#   nethos-kernel rt                       reboot into the real-time kernel
#   nethos-kernel rt --stay                ...and keep using it until told not to
#   nethos-kernel normal                   back to the stock kernel
#
# A kernel is the update that cannot be done in place and the one most likely
# to leave a machine that will not boot, which is the entire reason for the
# second slot. Nothing here touches the running system: the package is
# unpacked into the idle slot, its initramfs is built inside it, and the
# bootloader is pointed at it with three attempts. If it does not come up you
# are back on this kernel without doing anything.
set -euo pipefail

KERNELS=/boot/nethos-kernels.conf
say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# Checked per command, not here: `build` runs on any Linux machine -- the
# point of it is to use a faster one -- and requiring NETHOS's own layout
# would rule that out.
need_ab() {
    command -v nethos-ab >/dev/null 2>&1 || die "nethos-ab is not installed"
    [ -f /etc/nethos/slots.conf ] || die "no A/B layout -- see nethos-install --layout ab"
}

cmd_list() {
    echo "Standard and real-time kernels in the archive:"
    echo
    npkg search linux-image 2>/dev/null \
        | grep -E "^\s+linux-image-[0-9].*amd64\s" \
        | grep -vE "dbg|cloud|unsigned" \
        | sed 's/^ */  /' | sort -V | tail -12
    echo
    echo "  ...-rt-amd64 is PREEMPT_RT: the kernel preempts almost everywhere,"
    echo "  which is what the studio distributions ship for audio work. It"
    echo "  trades a little throughput for latency that does not spike."
    echo
    echo "Install one with: nethos-kernel install <package>"
}

kver_of() { sed -n "s/^$1=//p" "$KERNELS" 2>/dev/null | tail -1; }

cmd_current() {
    local run
    run=$(uname -r)
    echo "running        $run   (slot $(cat /etc/nethos/slot 2>/dev/null))"
    echo "slot A boots   $(kver_of A || echo '(newest on the ESP)')"
    echo "slot B boots   $(kver_of B || echo '(newest on the ESP)')"
    echo
    echo "preemption     $(cat /sys/kernel/debug/sched/preempt 2>/dev/null || echo 'unreadable -- needs root')"
}

cmd_install() {
    need_ab
    local pkg="$1"
    [ "$(id -u)" -eq 0 ] || die "needs root"
    [ -n "$pkg" ] || die "which package? try: nethos-kernel list"

    local idle dev mnt
    idle=$( [ "$(cat /etc/nethos/slot 2>/dev/null)" = A ] && echo B || echo A )
    dev=$(sed -n "s/^slot_$(echo "$idle" | tr 'A-Z' 'a-z')=//p" /etc/nethos/slots.conf)
    case "$dev" in LABEL=*) dev="/dev/disk/by-label/${dev#LABEL=}" ;; esac

    say "Making slot $idle match this system first"
    nethos-ab sync >/dev/null || die "could not fill slot $idle"

    mnt=$(mktemp -d)
    mount "$dev" "$mnt" || die "cannot mount slot $idle"
    # The ESP, so the kernel and initramfs land where the bootloader reads
    # them -- shared by both slots, which is why each slot pins its own
    # version rather than taking the newest.
    mkdir -p "$mnt/boot"
    mount --bind /boot "$mnt/boot"
    for d in /dev /dev/pts /proc /sys /run; do
        mkdir -p "$mnt$d"; mount --rbind "$d" "$mnt$d"
        mount --make-rslave "$mnt$d" 2>/dev/null || true
    done
    [ -e /etc/resolv.conf ] && cp -L /etc/resolv.conf "$mnt/etc/resolv.conf" 2>/dev/null || true

    cleanup() { umount -R "$mnt" 2>/dev/null || umount -Rl "$mnt" 2>/dev/null || true; rmdir "$mnt" 2>/dev/null || true; }
    trap cleanup EXIT

    say "Fetching $pkg into slot $idle"
    # --root, so the package is unpacked into the slot rather than into the
    # running system. npkg runs no maintainer scripts, so the initramfs and
    # module map below are ours to build; that is the same gap that has
    # produced every silent hardware fault in this project.
    if ! npkg --root "$mnt" fetch "$pkg"; then
        die "npkg could not install $pkg -- the running system is untouched"
    fi

    local kver
    kver=$(chroot "$mnt" sh -c 'ls -1 /lib/modules 2>/dev/null | sort -V | tail -1')
    [ -n "$kver" ] || die "no /lib/modules after install -- is $pkg a kernel?"
    say "Kernel $kver unpacked"

    say "Building its module map and initramfs inside the slot"
    chroot "$mnt" depmod -a "$kver" || die "depmod failed for $kver"
    if chroot "$mnt" sh -c 'command -v update-initramfs >/dev/null'; then
        chroot "$mnt" update-initramfs -c -k "$kver" || die "initramfs failed for $kver"
    else
        die "no update-initramfs in the slot; cannot build an initramfs for $kver"
    fi
    [ -e "$mnt/boot/vmlinuz-$kver" ] || die "no /boot/vmlinuz-$kver after install"

    # Record which kernel this slot boots, on the ESP both slots can read.
    touch "$KERNELS"
    sed -i "/^$idle=/d" "$KERNELS"
    echo "$idle=$kver" >> "$KERNELS"
    # And pin the running slot to what it is running, or regenerating grub
    # would hand it the new kernel too and there would be nothing to fall
    # back to.
    local here; here=$(cat /etc/nethos/slot 2>/dev/null || echo A)
    grep -q "^$here=" "$KERNELS" || echo "$here=$(uname -r)" >> "$KERNELS"

    cleanup; trap - EXIT

    say "Regenerating the bootloader"
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true

    nethos-ab switch
    say "Slot $idle runs $kver. Reboot to try it; three failures and you are back here."
}

# One boot on the real-time kernel, then back to normal by itself.
#
# grub-reboot writes an entry that GRUB uses once and clears, so this cannot
# leave the machine on a kernel somebody forgot they chose -- which matters
# because RT costs throughput every day and earns it only while recording.
# --stay makes it the default instead, for a session that will run for weeks.
cmd_boot_kernel() {
    need_ab
    local which="$1" stay="${2:-}" slot entry
    [ "$(id -u)" -eq 0 ] || die "needs root"
    slot=$(cat /etc/nethos/slot 2>/dev/null || echo A)
    slot=$(echo "$slot" | tr 'A-Z' 'a-z')

    if [ "$which" = rt ]; then
        entry="nethos-${slot}-rt"
        grep -q "id=\?'\?${entry}" /boot/grub/grub.cfg 2>/dev/null || \
            die "no real-time entry -- install one first:
  nethos-kernel install linux-image-\$(uname -r | sed 's/-amd64/-rt-amd64/')"
    else
        entry="nethos-${slot}"
    fi

    if [ "$stay" = "--stay" ]; then
        grub-editenv /boot/grub/grubenv set nethos_kernel="$which"
        grub-set-default "$entry"
        say "Default is now $entry. 'nethos-kernel normal' undoes it."
    else
        grub-reboot "$entry" || die "grub-reboot failed"
        say "Next boot only: $entry. The boot after that is normal again."
    fi

    printf 'Reboot now? [y/N] '
    read -r reply
    case "$reply" in [yY]*) systemctl reboot ;; *) say "Rebooting later is fine; the choice is saved." ;; esac
}


# --------------------------------------------------------------------------
# Building one
# --------------------------------------------------------------------------
cmd_build() {
    local version=7.2 bore=1 march="" cfg="" jobs="" out="$PWD" cross=auto base=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --version)  version="${2:?}"; shift 2 ;;
            --no-bore)  bore=0; shift ;;
            --march)    march="${2:?}"; shift 2 ;;
            --config)   cfg="${2:?}"; shift 2 ;;
            --jobs)     jobs="${2:?}"; shift 2 ;;
            --out)      out="${2:?}"; shift 2 ;;
            --cross)    cross=1; shift ;;
            --native)   cross=0; shift ;;
            --defconfig) base=defconfig; shift ;;
            *) die "unknown build option: $1" ;;
        esac
    done
    jobs="${jobs:-$(nproc)}"

    # Cross-compiling is the normal case now, not the exotic one.
    #
    # An x86 kernel cannot be compiled by an arm64 compiler, but it can be
    # compiled by an x86-targeting compiler running on arm64 -- at that
    # machine's full native speed, which is the entire point. Emulating an x86
    # machine to do the same work is hours instead of minutes.
    if [ "$cross" = auto ]; then
        if [ "$(uname -m)" = "x86_64" ]; then cross=0; else cross=1; fi
    fi
    if [ "$cross" = 1 ]; then
        export ARCH=x86_64
        export CROSS_COMPILE=x86_64-linux-gnu-
        say "Cross-compiling for x86_64 on $(uname -m)."
        # This machine's own config describes the wrong architecture, and
        # defconfig is the only sane base when there is no x86 kernel here to
        # copy one from.
        base=defconfig
    fi
    local series="v${version%%.*}.x"
    local src="$HOME/kernel"

    # Which CPU the kernel is *for*, which is not always the one building it.
    #
    # X86_NATIVE_CPU compiles for the machine doing the build. Build on a 5950X
    # for a 5500U and the kernel uses Zen 3 instructions the laptop cannot
    # execute: it will not boot, and the slot will catch it, but pointlessly.
    # So the target is named rather than assumed whenever they might differ.
    if [ -z "$march" ]; then
        if [ "$cross" = 1 ]; then
            # "native" would mean the arm64 host, which is not the target and
            # not even the right instruction set.
            march=x86-64-v3
            say "No --march given; building for $march (Zen 2 / Haswell and newer)."
            say "Older target? --march x86-64-v2. Specific CPU? --march znver2"
        else
            march=native
            say "No --march given; building for this machine (native)."
            say "Building for a different CPU? --march znver2 (Zen 2), znver3, x86-64-v3 ..."
        fi
    fi

    # Already root -- in a container, say -- means there is no sudo to call,
    # and debian images do not ship one. Asking for it there fails on a
    # missing command rather than on a missing privilege.
    local SUDO=sudo
    if [ "$(id -u)" = 0 ]; then SUDO=""; fi
    command -v sudo >/dev/null 2>&1 || SUDO=""

    say "Installing build dependencies"
    if command -v pacman >/dev/null 2>&1; then
        # Arch and CachyOS: base-devel carries gcc/make/flex/bison/bc, and the
        # kernel needs openssl, elfutils and pahole on top. --needed so this is
        # a no-op on a machine that already builds kernels, which a CachyOS box
        # very likely does.
        $SUDO pacman -S --needed --noconfirm base-devel bc openssl elfutils \
            pahole cpio zstd kmod curl >/dev/null || die "pacman could not install the toolchain"
    elif command -v apt-get >/dev/null 2>&1; then
        $SUDO apt-get update >/dev/null 2>&1 || true
        $SUDO apt-get install -y build-essential flex bison bc libssl-dev libelf-dev \
            dwarves cpio zstd kmod curl xz-utils >/dev/null \
            || die "apt could not install the toolchain"
        if [ "$cross" = 1 ]; then
            $SUDO apt-get install -y crossbuild-essential-amd64 >/dev/null \
                || die "apt could not install the x86_64 cross toolchain"
        fi
    elif command -v npkg >/dev/null 2>&1; then
        $SUDO npkg fetch build-essential flex bison bc libssl-dev libelf-dev \
            dwarves cpio zstd kmod >/dev/null || die "npkg could not install the toolchain"
    else
        say "  no apt or npkg; assuming the toolchain is present"
    fi
    for t in make flex bison bc; do
        command -v "$t" >/dev/null || die "$t is missing and could not be installed"
    done
    command -v "${CROSS_COMPILE:-}gcc" >/dev/null \
        || die "${CROSS_COMPILE:-}gcc is missing and could not be installed"
    say "Compiler: $(${CROSS_COMPILE:-}gcc --version | head -1)"

    mkdir -p "$src"; cd "$src"
    if [ ! -d "linux-$version" ]; then
        local tb="linux-$version.tar.xz"
        # A half-finished download must never look like a finished one.
        #
        # curl -o writes in place, so an interrupted fetch leaves a truncated
        # .tar.xz that the -f test happily accepts, and every later run fails
        # inside tar instead of re-fetching. Download beside it, prove it is
        # intact, and only then let it take the real name. This one died at
        # 42% on an HTTP/2 PROTOCOL_ERROR, which is exactly the case.
        if [ -f "$tb" ] && ! xz -t "$tb" 2>/dev/null; then
            say "  the cached $tb is corrupt; fetching it again"
            rm -f "$tb"
        fi
        if [ ! -f "$tb" ]; then
            say "Fetching linux $version"
            # --http1.1 because the HTTP/2 stream is what broke; --retry and
            # --continue-at resume rather than restart a 150MB transfer.
            curl -fL --http1.1 --progress-bar \
                 --retry 5 --retry-delay 3 --retry-all-errors \
                 --continue-at - -o "$tb.part" \
                 "https://cdn.kernel.org/pub/linux/kernel/$series/linux-$version.tar.xz" \
                || { rm -f "$tb.part"; die "could not download linux $version"; }
            xz -t "$tb.part" 2>/dev/null \
                || { rm -f "$tb.part"; die "the downloaded $tb is not a valid xz archive"; }
            mv "$tb.part" "$tb"
        fi
        say "Unpacking $tb"
        tar xf "$tb" || die "could not unpack $tb"
    fi
    [ -d "linux-$version" ] || die "linux-$version is missing after unpacking"
    cd "linux-$version"

    if [ "$bore" = 1 ] && ! grep -q SCHED_BORE kernel/sched/core.c 2>/dev/null; then
        say "Applying BORE"
        # The standalone patch, not the -cachy one: that variant expects the
        # rest of CachyOS's tree and fails six of its twenty-two hunks here.
        curl -fL -o ../bore-$version.patch \
            "https://raw.githubusercontent.com/CachyOS/kernel-patches/master/${version}/sched/0001-bore.patch" \
            2>/dev/null || die "no BORE patch published for $version yet -- try --no-bore"
        patch -p1 --dry-run < ../bore-$version.patch >/dev/null 2>&1 \
            || die "the BORE patch does not apply to $version cleanly"
        patch -p1 < ../bore-$version.patch >/dev/null
    fi

    say "Configuring"
    # A base config, then NETHOS's own requirements on top.
    #
    # The base only has to be a reasonable starting point -- defconfig is one.
    # What must be true of the result is in the repository, as a fragment,
    # because it belongs to the system rather than to whichever machine
    # happened to be reachable. Requiring a config fetched from another
    # computer meant a kernel could not be built while a laptop was asleep,
    # which is not a real dependency.
    if [ -n "$cfg" ]; then
        [ -r "$cfg" ] || die "--config $cfg cannot be read"
        cp "$cfg" .config
        say "  base: $cfg"
    elif [ "$base" = defconfig ]; then
        # Deliberate, not a fallback. A distro config enables nearly every
        # driver in the tree as a module: 6435 of them, a 2.5GB tarball, an
        # initrd too big for the ESP, and a longer boot every time. defconfig
        # plus the fragment below is a few hundred, which is what this system
        # actually uses.
        make defconfig >/dev/null
        say "  base: defconfig (lean; the fragment adds what NETHOS needs)"
    elif [ -r "/boot/config-$(uname -r)" ]; then
        cp "/boot/config-$(uname -r)" .config
        say "  base: this machine's running config"
    elif [ -r /proc/config.gz ]; then
        zcat /proc/config.gz > .config          # Arch and CachyOS keep it here
        say "  base: /proc/config.gz"
    else
        make defconfig >/dev/null
        say "  base: defconfig"
    fi
    make olddefconfig >/dev/null 2>&1

    # NETHOS's fragment, wherever this was run from.
    frag=""
    for c in /usr/share/nethos/kernel/nethos.config \
             "$(dirname "$0")/../kernel/nethos.config" \
             "$(dirname "$0")/../../payload/kernel/nethos.config" \
             ./payload/kernel/nethos.config; do
        [ -r "$c" ] && { frag="$c"; break; }
    done
    if [ -n "$frag" ]; then
        say "  applying $frag"
        while IFS= read -r line; do
            case "$line" in
                CONFIG_*=y) scripts/config --enable "${line%%=*}" ;;
                CONFIG_*=m) scripts/config --module "${line%%=*}" ;;
                CONFIG_*=*) scripts/config --set-val "${line%%=*}" "${line#*=}" ;;
            esac
        done < "$frag"
        make olddefconfig >/dev/null 2>&1

        # Say so when the fragment did not take.
        #
        # scripts/config writes whatever it is given, and olddefconfig then
        # quietly drops anything whose dependencies are unmet or whose symbol
        # does not exist. Both happened here: CONFIG_UINPUT is not a symbol
        # (it is INPUT_UINPUT), and ATH10K_PCI needs ATH10K on first. Nothing
        # complained, and the result was a kernel missing drivers that the
        # fragment plainly asked for -- discovered, if at all, on the machine
        # it was built for.
        # Every lookup here is allowed to fail -- that is the whole point --
        # so nothing in this loop may return non-zero to set -e. It did:
        # got=$(grep ...) carries grep's status when the symbol is absent, and
        # the build died having printed the header and not one finding.
        dropped=0
        while IFS= read -r line; do
            case "$line" in CONFIG_*=*) ;; *) continue ;; esac
            sym="${line%%=*}"; want="${line#*=}"
            if grep -q "^$sym=$want\$" .config 2>/dev/null; then
                continue
            fi
            if [ "$dropped" = 0 ]; then
                say "  these fragment options did not take:"
            fi
            got=$(grep -E "^$sym=" .config 2>/dev/null | head -1 || true)
            if [ -n "$got" ]; then got="${got#*=}"; else got="(absent)"; fi
            printf '    %-30s want=%-4s got=%s\n' "$sym" "$want" "$got"
            dropped=$((dropped + 1))
        done < "$frag" || true
        if [ "$dropped" -gt 0 ]; then
            say "  $dropped option(s) above are NOT in this kernel."
            say "  An absent one is usually a wrong symbol name or a missing"
            say "  parent option; check it against the tree's Kconfig."
        else
            say "  fragment: all options applied"
        fi
    else
        say "  WARNING: no nethos.config found; building with the base config only"
    fi

    # Debug info is a choice, and you cannot leave it by disabling DEBUG_INFO.
    #
    # CONFIG_DEBUG_INFO is not directly settable in modern kernels -- it is
    # selected by whichever member of the DEBUG_INFO_DWARF choice is on. Writing
    # "# CONFIG_DEBUG_INFO is not set" and enabling NONE alongside a DWARF5 that
    # is still set leaves two members of one choice enabled, and olddefconfig
    # resolves that back to DWARF. The config looked right and the modules came
    # out carrying full symbol tables: a 2.5 GB tarball where 300 MB was
    # expected, which then would not fit in the image at all.
    scripts/config --disable DEBUG_INFO_DWARF4 --disable DEBUG_INFO_DWARF5 \
                   --disable DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT \
                   --disable DEBUG_INFO_COMPRESSED_ZLIB \
                   --disable DEBUG_INFO_BTF --disable GDB_SCRIPTS \
                   --enable DEBUG_INFO_NONE
    scripts/config --disable MODULE_SIG --disable MODULE_SIG_ALL
    scripts/config --set-str SYSTEM_TRUSTED_KEYS "" --set-str SYSTEM_REVOCATION_KEYS ""
    scripts/config --disable HZ_250 --disable HZ_300 --enable HZ_1000 --set-val HZ 1000
    scripts/config --enable TCP_CONG_BBR
    [ "$bore" = 1 ] && scripts/config --enable SCHED_BORE
    if [ "$march" = native ]; then
        scripts/config --enable X86_NATIVE_CPU
    else
        scripts/config --disable X86_NATIVE_CPU
        # -march takes architecture levels, -mtune does not.
        #
        # x86-64-v3 names a feature level, and gcc rejects it outright as an
        # -mtune value: "bad value 'x86-64-v3' for '-mtune=' switch". Tuning
        # for "generic" is the right answer for a level anyway -- there is no
        # single pipeline to schedule for when the target is a whole class of
        # CPU. A named CPU tunes for itself.
        case "$march" in
            x86-64|x86-64-v2|x86-64-v3|x86-64-v4)
                export KCFLAGS="-march=$march -mtune=generic" ;;
            *)  export KCFLAGS="-march=$march -mtune=$march" ;;
        esac

        # Prove the compiler accepts them before the hour-long part rather
        # than finding out in the first object file it tries to build.
        if ! echo 'int main(void){return 0;}' \
             | ${CROSS_COMPILE:-}gcc $KCFLAGS -x c -c -o /dev/null - 2>/dev/null; then
            say "  the compiler rejects: $KCFLAGS"
            ${CROSS_COMPILE:-}gcc $KCFLAGS -x c -c -o /dev/null - </dev/null 2>&1 \
                | head -3 | sed 's/^/    /'
            die "--march $march is not something this compiler understands"
        fi
        say "  flags: $KCFLAGS (accepted)"
    fi
    make olddefconfig >/dev/null 2>&1

    # Check it actually took, before spending an hour finding out it did not.
    if grep -q '^CONFIG_DEBUG_INFO=y' .config; then
        say "  WARNING: debug info is still on. Modules will be several"
        say "           gigabytes and may not fit in the image."
    fi

    echo
    printf '  %-22s %s\n' "version"   "$version"
    printf '  %-22s %s\n' "BORE"      "$([ "$bore" = 1 ] && grep -q '^CONFIG_SCHED_BORE=y' .config && echo yes || echo no)"
    printf '  %-22s %s\n' "tick"      "$(grep -E '^CONFIG_HZ=' .config | cut -d= -f2)"
    printf '  %-22s %s\n' "target CPU" "$march"
    printf '  %-22s %s\n' "jobs"      "$jobs"
    echo

    say "Building (this is the long part)"
    make -j"$jobs" bzImage modules || die "the build failed"
    say "Packaging"
    # INSTALL_MOD_STRIP because the modules go into a disk image that has to
    # fit on a USB stick. Symbol tables in a shipped module tree cost hundreds
    # of megabytes and buy nothing unless you are debugging the kernel itself.
    make -j"$jobs" targz-pkg INSTALL_MOD_STRIP=1 >/dev/null || die "packaging failed"

    local tarball
    tarball=$(ls -1t linux-*.tar.gz 2>/dev/null | head -1)
    [ -n "$tarball" ] || die "no tarball produced"
    [ "$out" != "$PWD" ] && { mkdir -p "$out"; mv "$tarball" "$out/"; tarball="$out/$tarball"; }
    say "Built: $tarball"
    echo
    echo "  Install it here:        sudo nethos-kernel install-tar $tarball"
    echo "  Or copy to the target:  scp $tarball neth@HOST:/tmp/"
    echo "                          ssh neth@HOST sudo nethos-kernel install-tar /tmp/$(basename "$tarball")"
}

# --------------------------------------------------------------------------
cmd_install_tar() {
    need_ab
    local tar="$1"
    [ "$(id -u)" -eq 0 ] || die "needs root"
    [ -f "$tar" ] || die "no such file: $tar"

    local idle dev mnt kver
    idle=$( [ "$(cat /etc/nethos/slot 2>/dev/null)" = A ] && echo B || echo A )
    dev=$(sed -n "s/^slot_$(echo "$idle" | tr 'A-Z' 'a-z')=//p" /etc/nethos/slots.conf)
    case "$dev" in LABEL=*) dev="/dev/disk/by-label/${dev#LABEL=}" ;; esac

    say "Making slot $idle match this system first"
    nethos-ab sync >/dev/null || die "could not fill slot $idle"

    mnt=$(mktemp -d)
    mount "$dev" "$mnt" || die "cannot mount slot $idle"
    # /boot is the shared ESP: the kernel has to land there for GRUB to read
    # it, which is why this is a bind rather than the slot's own directory.
    mount --bind /boot "$mnt/boot"
    for d in /dev /dev/pts /proc /sys /run; do
        mkdir -p "$mnt$d"; mount --rbind "$d" "$mnt$d"; mount --make-rslave "$mnt$d" 2>/dev/null || true
    done
    cleanup() { umount -R "$mnt" 2>/dev/null || umount -Rl "$mnt" 2>/dev/null || true; rmdir "$mnt" 2>/dev/null || true; }
    trap cleanup EXIT

    say "Unpacking into slot $idle"
    tar xf "$tar" -C "$mnt" || die "could not unpack"
    kver=$(chroot "$mnt" sh -c 'ls -1 /lib/modules | sort -V | tail -1')
    [ -n "$kver" ] || die "no modules found after unpacking"

    say "Module map and initramfs for $kver"
    chroot "$mnt" depmod -a "$kver" || die "depmod failed"
    chroot "$mnt" update-initramfs -c -k "$kver" || die "initramfs failed"
    [ -e "$mnt/boot/vmlinuz-$kver" ] || die "no /boot/vmlinuz-$kver -- the tarball may not contain one"

    # Pin it to this slot only. Without this both slots take the newest kernel
    # on the shared ESP, and the first one that fails takes the fallback too.
    touch "$KERNELS"; sed -i "/^$idle=/d" "$KERNELS"; echo "$idle=$kver" >> "$KERNELS"
    local here; here=$(cat /etc/nethos/slot 2>/dev/null || echo A)
    grep -q "^$here=" "$KERNELS" || echo "$here=$(uname -r)" >> "$KERNELS"

    cleanup; trap - EXIT
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
    nethos-ab switch
    say "Slot $idle runs $kver. Reboot to try it; three failures and you are back here."
}

# Repackage a tree that is already built, without recompiling it.
#
# Exists because a kernel can take an hour to compile and the thing that went
# wrong -- symbols left in the modules -- is fixed at install time, not at
# compile time. make targz-pkg reuses every object already built, so this turns
# a 2.5 GB tarball into a usable one in a couple of minutes.
cmd_repack() {
    local jobs="" out="$PWD" src=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --jobs) jobs="${2:?}"; shift 2 ;;
            --out)  out="${2:?}"; shift 2 ;;
            --tree) src="${2:?}"; shift 2 ;;
            *) die "unknown repack option: $1" ;;
        esac
    done
    jobs="${jobs:-$(nproc)}"
    if [ -z "$src" ]; then
        [ -f Makefile ] && [ -d kernel ] && src="$PWD"
        [ -z "$src" ] && src=$(ls -1td "$HOME"/kernel/linux-* 2>/dev/null | head -1)
    fi
    [ -n "$src" ] && [ -d "$src" ] || die "no kernel tree found -- pass --tree DIR"
    cd "$src" || die "cannot enter $src"
    [ -f .config ] || die "$src has no .config -- it was never configured"
    say "Repacking $src (stripped, no recompile)"
    rm -f linux-*.tar.gz
    make -j"$jobs" targz-pkg INSTALL_MOD_STRIP=1 >/dev/null || die "packaging failed"
    local tarball
    tarball=$(ls -1t linux-*.tar.gz 2>/dev/null | head -1)
    [ -n "$tarball" ] || die "no tarball produced"
    if [ "$out" != "$PWD" ]; then
        mkdir -p "$out"; mv "$tarball" "$out/"; tarball="$out/$tarball"
    fi
    say "Built: $tarball  ($(du -h "$tarball" | cut -f1))"
}

case "${1:-list}" in
    list)    cmd_list ;;
    current) cmd_current ;;
    install) shift; cmd_install "${1:-}" ;;
    build)   shift; cmd_build "$@" ;;
    repack)  shift; cmd_repack "$@" ;;
    install-tar) shift; cmd_install_tar "${1:-}" ;;
    rt)      shift; cmd_boot_kernel rt "${1:-}" ;;
    normal)  shift; cmd_boot_kernel normal "${1:-}" ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \?//' ;;
    *) die "unknown command: $1" ;;
esac
