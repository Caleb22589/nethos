#!/bin/bash
# Install NETHOS from the live ISO onto a real disk.
#
#   nethos-install --list                 show candidate disks and exit
#   nethos-install --target /dev/sda      install (asks for confirmation)
#   nethos-install --target /dev/sda -n   dry run: print the plan, touch nothing
#
# Options:
#   --hostname NAME    system hostname (default nethos)
#   --no-confirm       skip the typed confirmation (for unattended installs)
#   --layout ab|single how the disk is carved up (default: ab on >=64G)
#   --online           build the system from the archive instead of copying
#                      this one -- what the lightweight installer image uses,
#                      because there is no full system on it to copy
#   --slot-size SIZE   size of each system slot, e.g. 24G
#
# The default layout reserves the second slot now, empty. It cannot be added
# later without shrinking a mounted filesystem, which ext4 does not do -- a
# disk handed entirely to one root is a disk that can never do A/B updates.
# The space costs nothing until an update uses it.
#
# THIS ERASES THE TARGET DISK COMPLETELY. Everything on it is destroyed:
# partition table, filesystems, other operating systems, all data. There is no
# undo. The confirmation prompt is deliberate — read the summary before typing.
set -euo pipefail

TARGET=""
HOSTNAME_NEW="nethos"
DRY_RUN=0
CONFIRM=1
LIST=0
LAYOUT=""
SLOT_SIZE=""
NETH_USER="${NETH_USER:-neth}"

while [ $# -gt 0 ]; do
    case "$1" in
        --target|-t) TARGET="${2:?--target needs a device}"; shift 2 ;;
        --hostname) HOSTNAME_NEW="${2:?}"; shift 2 ;;
        --dry-run|-n) DRY_RUN=1; shift ;;
        --online) ONLINE=1; shift; continue ;;
        --no-confirm) CONFIRM=0; shift ;;
        --layout) LAYOUT="${2:?--layout needs ab or single}"; shift 2 ;;
        --slot-size) SLOT_SIZE="${2:?--slot-size needs a size}"; shift 2 ;;
        --list|-l) LIST=1; shift ;;
        -h|--help) sed -n '2,26p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done

# NVMe and mmc name partitions p1/p2 rather than 1/2. Needed before the plan
# is printed, not only when creating filesystems, or the summary describes
# devices that will not exist.
part_prefix() {
    case "$1" in
        *nvme*|*mmcblk*|*loop*) printf '%sp' "$1" ;;
        *)                      printf '%s'  "$1" ;;
    esac
}

# Bytes -> a size sgdisk understands, and back, without bc.
disk_bytes() { blockdev --getsize64 "$1" 2>/dev/null || echo 0; }

# A slot has to hold a complete system with room to grow: ~2.5G installed
# today, and an App Store that exists to add to it. A sixth of the disk,
# clamped, so a 512G NVMe gets 32G slots and a 64G stick still gets 8G.
default_slot_size() {
    gb=$(( $(disk_bytes "$1") / 1073741824 ))
    slot=$(( gb / 6 ))
    [ "$slot" -lt 8 ]  && slot=8
    [ "$slot" -gt 32 ] && slot=32
    printf '%dG' "$slot"
}

say()  { printf '\n\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root"

# --------------------------------------------------------------------------
# what can we install onto
# --------------------------------------------------------------------------
live_device() {
    # The disk the live ISO itself came from — never a valid target.
    local src
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
    [ -n "$src" ] && lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

LIVE_DISK="$(live_device || true)"

list_disks() {
    printf '%-12s %-10s %-8s %s\n' DEVICE SIZE TYPE MODEL
    lsblk -dno NAME,SIZE,TYPE,MODEL | while read -r name size type model; do
        case "$type" in disk) ;; *) continue ;; esac
        case "$name" in loop*|ram*|sr*) continue ;; esac
        local note=""
        [ "$name" = "$LIVE_DISK" ] && note="   <- live media, cannot install here"
        printf '/dev/%-7s %-10s %-8s %s%s\n' "$name" "$size" "$type" "${model:-—}" "$note"
    done
}

if [ "$LIST" -eq 1 ] || [ -z "$TARGET" ]; then
    say "Disks on this machine"
    list_disks
    [ -z "$TARGET" ] && {
        printf '\nPick one and run:  nethos-install --target /dev/sdX\n'
        printf 'Add -n first for a dry run that changes nothing.\n\n'
        exit 0
    }
    exit 0
fi

# --------------------------------------------------------------------------
# validate the target
# --------------------------------------------------------------------------
[ -b "$TARGET" ] || die "not a block device: $TARGET"

TARGET_NAME="$(basename "$TARGET")"
[ "$(lsblk -dno TYPE "$TARGET")" = "disk" ] \
    || die "$TARGET is not a whole disk — pass the disk (/dev/sda), not a partition"

[ "$TARGET_NAME" = "$LIVE_DISK" ] \
    && die "$TARGET is the live media you booted from"

# Anything mounted from this disk means it is in use; refuse rather than
# corrupt a running system.
if lsblk -no MOUNTPOINTS "$TARGET" | grep -qE '\S'; then
    lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS "$TARGET"
    die "$TARGET has mounted partitions — unmount them first"
fi

if [ -d /sys/firmware/efi ]; then
    FIRMWARE=UEFI
else
    FIRMWARE=BIOS
fi

SIZE="$(lsblk -dno SIZE "$TARGET")"
MODEL="$(lsblk -dno MODEL "$TARGET" | sed 's/ *$//')"

# --------------------------------------------------------------------------
say "Install plan"
# --------------------------------------------------------------------------
PART_PREFIX="$(part_prefix "$TARGET")"
ESP_SIZE=512M
DISK_GB=$(( $(disk_bytes "$TARGET") / 1073741824 ))
# A/B needs room for two systems and a data partition; below that it is not a
# kindness, it is a disk you cannot install onto.
if [ -z "$LAYOUT" ]; then
    if [ "$DISK_GB" -ge 64 ]; then LAYOUT=ab; else LAYOUT=single; fi
fi
case "$LAYOUT" in
    ab|single) ;;
    *) die "--layout must be ab or single" ;;
esac
[ -n "$SLOT_SIZE" ] || SLOT_SIZE="$(default_slot_size "$TARGET")"
if [ "$LAYOUT" = ab ] && [ "$DISK_GB" -lt 32 ]; then
    die "$TARGET is ${DISK_GB}G — too small for two slots; pass --layout single"
fi

cat <<EOF

  Target disk   : $TARGET  ($SIZE${MODEL:+, $MODEL})
  Firmware      : $FIRMWARE
  Hostname      : $HOSTNAME_NEW
  User          : $NETH_USER  (password: nethos — change it after first login)

  Layout        : $LAYOUT ($SLOT_SIZE per slot)
  Partitioning  : GPT, wiping everything currently on $TARGET
EOF
if [ "$LAYOUT" = ab ]; then
cat <<EOF
                  ${PART_PREFIX}1  ${ESP_SIZE}  EFI System (FAT32, mounted at /boot)
                  ${PART_PREFIX}2  ${SLOT_SIZE}  system slot A (ext4, this install)
                  ${PART_PREFIX}3  ${SLOT_SIZE}  system slot B (ext4, empty until an update)
                  ${PART_PREFIX}4  rest  data (ext4, /home and machine state)
                  bootloader: GRUB (slot A only for now — the slot B entry
                              and the boot counter arrive with the first
                              A/B update; slot B is empty until then)
EOF
elif [ "$FIRMWARE" = UEFI ]; then
cat <<EOF
                  ${PART_PREFIX}1  512M  EFI System (FAT32, mounted at /boot)
                  ${PART_PREFIX}2  rest  Linux root (ext4)
                  bootloader: GRUB (x86_64-efi)
EOF
else
cat <<EOF
                  ${PART_PREFIX}1    1M  BIOS boot partition
                  ${PART_PREFIX}2  rest  Linux root (ext4)
                  bootloader: GRUB (i386-pc, installed to the MBR)
EOF
fi
echo
echo "  Current contents of $TARGET:"
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$TARGET" | sed 's/^/    /'
echo

if [ "$DRY_RUN" -eq 1 ]; then
    say "Dry run — nothing was changed."
    exit 0
fi

warn "This ERASES $TARGET completely. All data on it will be lost."
if [ "$CONFIRM" -eq 1 ]; then
    printf '\nType ERASE %s to continue: ' "$TARGET"
    read -r reply
    [ "$reply" = "ERASE $TARGET" ] || die "not confirmed — nothing was changed"
fi

# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Everything this needs, checked before anything is touched.
#
# This ran wipefs and then died on a missing sgdisk, which left a disk with no
# partition table and no new one -- the single worst outcome available, and it
# happened on the first real use. A tool that destroys before it checks is
# only safe by luck. Nothing below this point is reversible, so nothing above
# it is allowed to be optional.
# --------------------------------------------------------------------------
missing=""
for tool in sgdisk partprobe mkfs.ext4 mkfs.fat rsync blkid chroot \
            grub-install grub-mkconfig lsblk wipefs; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
    die "missing required tools:$missing
  Install them first. On NETHOS:  sudo npkg fetch gdisk dosfstools rsync grub-efi-amd64
  Nothing has been changed."
fi

say "Partitioning $TARGET"
# --------------------------------------------------------------------------
wipefs -a "$TARGET"
sgdisk --zap-all "$TARGET"

if [ "$LAYOUT" = ab ]; then
    # Both slots the same size, because either of them has to be able to hold
    # the system the other one is running. Data last and unsized, so it takes
    # whatever is left -- it is the partition that should grow with the disk,
    # not the systems.
    sgdisk -n1:0:+"$ESP_SIZE"  -t1:ef00 -c1:"NETHOS EFI"    "$TARGET"
    sgdisk -n2:0:+"$SLOT_SIZE" -t2:8300 -c2:"NETHOS slot A" "$TARGET"
    sgdisk -n3:0:+"$SLOT_SIZE" -t3:8300 -c3:"NETHOS slot B" "$TARGET"
    sgdisk -n4:0:0             -t4:8300 -c4:"NETHOS data"   "$TARGET"
elif [ "$FIRMWARE" = UEFI ]; then
    sgdisk -n1:0:+512M -t1:ef00 -c1:"NETHOS EFI" "$TARGET"
    sgdisk -n2:0:0     -t2:8300 -c2:"NETHOS root" "$TARGET"
else
    sgdisk -n1:0:+1M   -t1:ef02 -c1:"BIOS boot" "$TARGET"
    sgdisk -n2:0:0     -t2:8300 -c2:"NETHOS root" "$TARGET"
fi
partprobe "$TARGET" 2>/dev/null || true
sleep 2

P1="${PART_PREFIX}1"
P2="${PART_PREFIX}2"
P3="${PART_PREFIX}3"
P4="${PART_PREFIX}4"

say "Creating filesystems"
if [ "$LAYOUT" = ab ]; then
    mkfs.fat -F32 -n NETHOSEFI "$P1"
    # Labels carry the slot, so fstab and GRUB can name a slot without
    # hardcoding a device that changes when a disk moves.
    mkfs.ext4 -F -L NETHOS_A "$P2"
    mkfs.ext4 -F -L NETHOS_B "$P3"
    mkfs.ext4 -F -L NETHOSDATA "$P4"
else
    [ "$FIRMWARE" = UEFI ] && mkfs.fat -F32 -n NETHOSEFI "$P1"
    mkfs.ext4 -F -L NETHOS "$P2"
fi

# --------------------------------------------------------------------------
say "Copying the system to disk"
# --------------------------------------------------------------------------
MNT=/mnt/nethos-install
mkdir -p "$MNT"
mount "$P2" "$MNT"
if [ "$LAYOUT" = ab ] || [ "$FIRMWARE" = UEFI ]; then
    mkdir -p "$MNT/boot"
    mount "$P1" "$MNT/boot"
fi
if [ "$LAYOUT" = ab ]; then
    # /home lives on the data partition, not in the slot. This is the whole
    # point of the layout: an update replaces a slot wholesale, and anything
    # inside it goes with it. rsync below would otherwise copy the live
    # /home into the slot and the first update would delete it.
    mkdir -p "$MNT/home"
    mount "$P4" "$MNT/home"
fi

if [ "${ONLINE:-0}" = 1 ]; then
    # Build the system from the archive, because there is not one here to copy.
    #
    # The lightweight installer is a hundred megabytes: a kernel, busybox,
    # python and enough firmware to get online. Copying it onto the disk would
    # install the installer, which is not what anybody wants. So npkg builds a
    # real NETHOS root on the target the same way the image build does, and the
    # machine ends up with a current system rather than whatever the stick was
    # made with.
    NPKG_DIR=""
    for d in /usr/share/nethos/pkg /nethos/pkg; do
        [ -f "$d/npkg_bootstrap.py" ] && NPKG_DIR="$d" && break
    done
    [ -n "$NPKG_DIR" ] || die "no npkg on this installer; cannot build a system"
    command -v python3 >/dev/null || die "no python3 on this installer"
    ip route 2>/dev/null | grep -q '^default' \
        || die "no network. The full system is downloaded, so one is required."

    say "Building the system on $TARGET (this downloads roughly 700MB)"
    python3 -u "$NPKG_DIR/npkg_bootstrap.py" "$MNT" \
        --set base --set system --set kernel --set desktop --set firmware --set net \
        --arch amd64 --user "$NETH_USER" --work /tmp/npkg-work --keep \
        || die "the system could not be built -- nothing was written to the bootloader"

    # The desktop, the tools and the shell: everything the image build installs
    # after the packages land.
    PAYLOAD_DIR=""
    for d in /usr/share/nethos/payload /nethos/payload; do
        [ -f "$d/install-nethos.sh" ] && PAYLOAD_DIR="$d" && break
    done
    if [ -n "$PAYLOAD_DIR" ]; then
        say "Installing the NETHOS layer"
        mkdir -p "$MNT/root/payload"
        cp -R "$PAYLOAD_DIR/." "$MNT/root/payload/"
    fi
else
    # Copy the live filesystem rather than pacstrapping: it needs no network and
    # it guarantees the installed system is exactly what you just tried.
    rsync -aAXH --info=progress2 \
        --exclude=/dev/ --exclude=/proc/ --exclude=/sys/ --exclude=/tmp/ \
        --exclude=/run/ --exclude=/mnt/ --exclude=/media/ --exclude=/lost+found \
        / "$MNT/"
fi

# The disk being installed to is not a live stick, whatever it was copied from.
# Without this the installed system boots the installer again, for ever.
rm -f "$MNT/etc/nethos/live"

mkdir -p "$MNT"/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 "$MNT/tmp"

say "Generating fstab"
# genfstab is an Arch tool and this is a Debian system; it was never here.
# UUIDs rather than device names, because /dev/sda is whatever the firmware
# enumerated first and that changes when a USB stick is plugged in.
{
    echo "# Written by nethos-install"
    printf 'UUID=%s  /      ext4  defaults,noatime  0 1\n' "$(blkid -s UUID -o value "$P2")"
    if [ "$LAYOUT" = ab ] || [ "$FIRMWARE" = UEFI ]; then
        printf 'UUID=%s  /boot  vfat  defaults,umask=0077  0 2\n' "$(blkid -s UUID -o value "$P1")"
    fi
    if [ "$LAYOUT" = ab ]; then
        printf 'UUID=%s  /home  ext4  defaults,noatime  0 2\n' "$(blkid -s UUID -o value "$P4")"
    fi
} > "$MNT/etc/fstab"

if [ "$LAYOUT" = ab ]; then
    # Which slot this system is, recorded inside the system itself. An update
    # reads it to know which slot to write to -- the answer must come from the
    # running system rather than from the bootloader, which can be wrong about
    # what actually booted after a failed switch.
    mkdir -p "$MNT/etc/nethos"
    printf 'A\n' > "$MNT/etc/nethos/slot"
    cat > "$MNT/etc/nethos/slots.conf" <<SLOTS
# The layout this system was installed with. nethos-update reads it to find
# the slot it is not running from.
layout=ab
slot_a=LABEL=NETHOS_A
slot_b=LABEL=NETHOS_B
data=LABEL=NETHOSDATA
esp=LABEL=NETHOSEFI
SLOTS
fi

# --------------------------------------------------------------------------
say "Turning the live image into an installed system"
# --------------------------------------------------------------------------
cat > "$MNT/root/nethos-post-install.sh" <<POST
#!/bin/bash
set -euo pipefail

# Live-only pieces that must not survive onto a real install.
rm -f /etc/systemd/system/multi-user.target.wants/nethos-live-setup.service
rm -f /etc/systemd/system/nethos-live-setup.service
rm -f /etc/mkinitcpio.conf.d/archiso.conf
rm -rf /etc/systemd/system/getty@tty1.service.d/autovt.conf
rm -f /etc/systemd/system/multi-user.target.wants/{pacman-init,choose-mirror,reflector}.service 2>/dev/null || true
rm -f /etc/systemd/system/{pacman-init,choose-mirror}.service 2>/dev/null || true
rm -f /etc/sudoers.d/g_wheel 2>/dev/null || true
rm -rf /root/{.automated_script.sh,.zlogin} /etc/systemd/logind.conf.d 2>/dev/null || true
rm -f /usr/local/bin/{Installation_guide,choose-mirror,livecd-sound} 2>/dev/null || true

echo "$HOSTNAME_NEW" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME_NEW.localdomain $HOSTNAME_NEW
HOSTS

# The live ISO's initramfs only knows how to boot a squashfs. Rebuild it as an
# ordinary one or the installed system will not come up.
cat > /etc/mkinitcpio.conf <<MKI
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
MKI
# Create it, do not merely update it.
#
# -u updates an initramfs that already exists, and a root built from the
# archive has none -- so this did nothing at all, GRUB booted a kernel with no
# initrd, and the machine panicked with "VFS: Unable to mount root fs on
# unknown-block(0,0)" because nothing had loaded the NVMe driver. The install
# had gone perfectly right up to that point.
if command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -c -k all || update-initramfs -u -k all || true
elif command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P
fi

# And prove it, because a missing initrd is only discovered at the panic.
kver=$(ls -1 /lib/modules 2>/dev/null | sort -V | tail -1)
if [ -n "$kver" ] && [ ! -e "/boot/initrd.img-$kver" ] && [ ! -e "/boot/initramfs-$kver.img" ]; then
    echo "FATAL: no initramfs for $kver."
    echo "  The kernel cannot reach the root filesystem without one and would"
    echo "  panic on the first boot. Refusing to install a bootloader for it."
    ls -la /boot | sed 's/^/    /'
    exit 1
fi
echo "initramfs: $(ls -1 /boot/initrd.img-* /boot/initramfs-*.img 2>/dev/null | tr "\n" " ")"

systemctl enable systemd-networkd systemd-resolved 2>/dev/null || true
systemctl enable NetworkManager 2>/dev/null || true

# Bootloader
if [ -d /sys/firmware/efi ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot \
                 --bootloader-id=NETHOS --removable
    grub-install --target=x86_64-efi --efi-directory=/boot \
                 --bootloader-id=NETHOS 2>/dev/null || true
else
    grub-install --target=i386-pc "$TARGET"
fi
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' /etc/default/grub 2>/dev/null || true
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="NETHOS"/' /etc/default/grub 2>/dev/null || true
grub-mkconfig -o /boot/grub/grub.cfg

# The NETHOS layer, when the system was built from the archive rather than
# copied. install-nethos.sh puts the shell, the apps and the nethos-* tools in
# place and enables the services; --no-packages because npkg already ran.
if [ -f /root/payload/install-nethos.sh ]; then
    sh /root/payload/install-nethos.sh --no-packages || \
        echo "WARNING: the NETHOS layer did not install cleanly"
    rm -rf /root/payload
fi

# Mark this as an installed build, not a live session.
date -u +'%Y-%m-%dT%H:%M:%SZ' > /etc/nethos-release
POST

chmod +x "$MNT/root/nethos-post-install.sh"
# arch-chroot is the same Arch tool; this is what it does that plain chroot
# does not. resolv.conf too, or anything in the post-install that resolves a
# name fails inside a system that has no /etc/resolv.conf yet.
for d in /dev /dev/pts /proc /sys /run; do
    mkdir -p "$MNT$d"
    mount --rbind "$d" "$MNT$d"
    mount --make-rslave "$MNT$d" 2>/dev/null || true
done
[ -e /etc/resolv.conf ] && cp -L /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true
chroot "$MNT" /root/nethos-post-install.sh
rm -f "$MNT/root/nethos-post-install.sh"

say "Unmounting"
sync
# -R and lazy: the rbinds above make this a tree, and a stray reference to
# anything under it leaves the new root mounted and the disk busy.
umount -R "$MNT" 2>/dev/null || umount -Rl "$MNT" 2>/dev/null || true

say "NETHOS is installed on $TARGET."
cat <<EOF

  Remove the USB stick and reboot.
  Log in as ${NETH_USER} / nethos — then change the password:  passwd

  Keep it updated with:  nethos-update

EOF
