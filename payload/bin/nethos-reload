#!/bin/bash
# Apply changes to a running NETHOS. No reboot, no logout.
#
#   nethos-reload            reload every open surface (panel, menu, apps)
#   nethos-reload --daemon   also restart nethosd, for changes to the API
#   nethos-reload --shell    also relaunch the panel window itself
#
# Editing files under /usr/share/nethos already triggers this automatically --
# nethosd watches the tree and pushes a reload within a second. This command is
# for when you want it right now, or you changed nethosd itself.
set -euo pipefail

API="http://127.0.0.1:7777"
DAEMON=0
SHELL_RESTART=0

for arg in "$@"; do
    case "$arg" in
        --daemon|-d) DAEMON=1 ;;
        --shell|-s)  SHELL_RESTART=1 ;;
        --all|-a)    DAEMON=1; SHELL_RESTART=1 ;;
        -h|--help)   sed -n '2,12p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown option: $arg" >&2; exit 2 ;;
    esac
done

say() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }

if [ "$DAEMON" -eq 1 ]; then
    say "Restarting nethosd"
    # Clear any unsupervised nethosd still holding port 7777 (e.g. one started
    # directly by an older nethos-session), otherwise the unit cannot bind and
    # systemd sits in a restart loop while the stale daemon keeps serving.
    # The bracket in the pattern stops pkill matching its own command line --
    # and, more importantly, matching the shell that is running this script.
    systemctl --user stop nethosd 2>/dev/null || true
    pkill -f "[/]usr/bin/nethosd" 2>/dev/null || true
    sleep 1
    systemctl --user restart nethosd
    for _ in $(seq 1 100); do
        curl -sf -o /dev/null "$API/api/status" && break
        sleep 0.1
    done
fi

if [ "$SHELL_RESTART" -eq 1 ]; then
    # This asked swaymsg to kill a Chromium window, and by the time anyone ran
    # it the shell was nethos-view under Wayfire. Both halves missed: swaymsg
    # is not there to answer, the app_id never matched, so nothing was killed
    # -- and then a second nethos-session was started on top of the first,
    # which is two panels and two docks rather than a restart.
    #
    # nethos-session ends in `exec nethos-view`, so the shell is that one
    # process and role=panel is only ever on it. Matching that leaves
    # application windows -- which are also nethos-view -- alone. The bracket
    # keeps the pattern from matching this script's own command line.
    say "Relaunching the shell"
    pkill -f "[n]ethos-view.*role=panel" 2>/dev/null || true
    sleep 1
    # setsid, so the shell does not die with the SSH session or terminal that
    # asked for the restart -- which is exactly how this gets run.
    setsid nohup nethos-session >/dev/null 2>&1 &
    exit 0
fi

say "Broadcasting reload"
curl -sf -X POST -H 'Content-Type: application/json' \
    -d '{"reason":"nethos-reload"}' "$API/api/reload" >/dev/null
say "Done — every open NETHOS surface has reloaded."
