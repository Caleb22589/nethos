#!/bin/sh
# The NETHOS installer: connect, choose a disk, install.
#
# A wizard, in that order, because that is the order the machine needs them in.
# The first version was a menu whose first item refused to run until you had
# used its second item, which is a puzzle rather than an installer.
#
# No NetworkManager. There is no systemd in this initramfs -- the installer is
# started directly by init -- so nmcli has no daemon to talk to and fails with
# "could not create NMClient". wpa_supplicant and udhcpc are driven here
# directly, which is fewer moving parts than a service manager anyway.
set -eu

B=$(printf '\033[1m'); D=$(printf '\033[2m'); R=$(printf '\033[0m')
C=$(printf '\033[1;36m'); RD=$(printf '\033[1;31m'); G=$(printf '\033[1;32m')

head() {
    clear 2>/dev/null || true
    printf '\n  %sNETHOS%s\n  %s%s%s\n\n' "$C" "$R" "$D" "${1:-}" "$R"
}
say()  { printf '  %s\n' "$*"; }
warn() { printf '  %s%s%s\n' "$RD" "$*" "$R"; }
ok()   { printf '  %s%s%s\n' "$G" "$*" "$R"; }
ask()  { printf '  %s ' "$1"; read -r REPLY || REPLY=""; }
askpw() {
    printf '  %s ' "$1"
    stty -echo 2>/dev/null || true
    read -r PW || PW=""
    stty echo 2>/dev/null || true
    printf '\n'
}
pause() { printf '\n'; ask "press enter"; }

[ "$(id -u)" = 0 ] || exec sudo -- "$0" "$@"

online() { ip route 2>/dev/null | grep -q '^default'; }
ifaces()  { ls /sys/class/net 2>/dev/null | grep -v '^lo$'; }
is_wifi() { [ -d "/sys/class/net/$1/wireless" ] || [ -e "/sys/class/net/$1/phy80211" ]; }
has_carrier() { [ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null || echo 0)" = 1 ]; }

dhcp_on() {
    ip link set "$1" up 2>/dev/null || true
    # busybox udhcpc first: it is always here and needs no lease database.
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i "$1" -n -q -t 6 -T 2 >/dev/null 2>&1 && return 0
    fi
    command -v dhclient >/dev/null 2>&1 && dhclient -1 -timeout 15 "$1" >/dev/null 2>&1 && return 0
    return 1
}

# ------------------------------------------------------------------ network
wifi_connect() {   # $1 interface
    dev=$1
    ip link set "$dev" up 2>/dev/null || true
    say "Scanning..."
    # One network per line as "signal<TAB>ssid", strongest first.
    #
    # The SSID is everything after "SSID: " -- it can contain spaces, so it
    # cannot be a field. Taking $2 lost half of them and leaving awk to rebuild
    # $0 left a leading space on the rest, which then reached wpa_supplicant as
    # part of the name and matched nothing.
    scan=$(iw dev "$dev" scan 2>/dev/null | awk '
        /^\tsignal:/ { sig = $2 }
        /^\tSSID: /  {
            ssid = substr($0, index($0, "SSID: ") + 6)
            gsub(/[^[:print:]]/, "", ssid)
            if (ssid != "" && !(ssid in seen)) { seen[ssid] = 1; printf "%d\t%s\n", sig, ssid }
        }' | sort -rn | head -15)

    if [ -z "$scan" ]; then
        warn "No networks found on $dev."
        say "If this wifi chip needs firmware that is not in this 98MB image,"
        say "nothing will appear here. Ethernet or a phone over USB needs none."
        return 1
    fi

    printf '\n'
    # Numbered into a file: a pipeline runs the loop in a subshell, so the
    # counter it increments is gone by the time the list is read back.
    printf '%s\n' "$scan" | nl -w3 -s'  ' > /tmp/wifi.list
    while IFS= read -r line; do
        num=$(printf '%s' "$line" | awk '{print $1}')
        sig=$(printf '%s' "$line" | cut -f1 | awk '{print $2}')
        ssid=$(printf '%s' "$line" | cut -f2-)
        printf '   %s%3s%s  %-30.30s  %5s dBm\n' "$B" "$num" "$R" "$ssid" "$sig"
    done < /tmp/wifi.list
    printf '\n'

    ask "network number (or blank to go back):"
    [ -n "$REPLY" ] || return 1
    case "$REPLY" in *[!0-9]*) warn "not a number"; return 1 ;; esac
    ssid=$(sed -n "${REPLY}p" /tmp/wifi.list 2>/dev/null | cut -f2-)
    [ -n "$ssid" ] || { warn "no such number"; return 1; }

    askpw "password for \"$ssid\" (blank if the network is open):"

    conf=/tmp/wpa.conf
    if [ -z "$PW" ]; then
        printf 'network={\n  ssid="%s"\n  key_mgmt=NONE\n}\n' "$ssid" > "$conf"
    else
        # Written straight in rather than run through wpa_passphrase.
        # wpa_supplicant takes a plaintext psk, so the hashing step is one more
        # program to be missing -- and when it was, the failure was reported as
        # "password must be 8-63 characters", which blamed the password for a
        # command that was not there.
        len=$(printf '%s' "$PW" | wc -c | tr -d ' ')
        if [ "$len" -lt 8 ] || [ "$len" -gt 63 ]; then
            warn "a WPA password is 8 to 63 characters; that one is $len"
            return 1
        fi
        printf 'network={\n  ssid="%s"\n  psk="%s"\n}\n' "$ssid" "$PW" > "$conf"
    fi
    chmod 600 "$conf"

    pkill wpa_supplicant 2>/dev/null || true
    say "Connecting to $ssid..."
    if ! wpa_supplicant -B -i "$dev" -c "$conf" >/tmp/wpa.log 2>&1; then
        warn "wpa_supplicant would not start:"
        tail -3 /tmp/wpa.log 2>/dev/null | sed 's/^/    /'
        return 1
    fi
    n=0
    while [ $n -lt 20 ]; do
        iw dev "$dev" link 2>/dev/null | grep -q "Connected to" && break
        n=$((n + 1)); sleep 1
    done
    if ! iw dev "$dev" link 2>/dev/null | grep -q "Connected to"; then
        warn "could not associate with $ssid -- wrong password, or out of range"
        return 1
    fi
    say "Associated. Getting an address..."
    dhcp_on "$dev" || { warn "associated, but DHCP gave no address"; return 1; }
    online
}

step_network() {
    while :; do
        head "Step 1 of 3   Network"
        if online; then
            ok "Connected."
            ip -br addr 2>/dev/null | grep -v '^lo' | sed 's/^/    /'
            printf '\n'
            say "NETHOS is downloaded during the install, about 700MB."
            pause
            return 0
        fi

        say "NETHOS is downloaded during the install, so a connection is needed."
        printf '\n'

        # Wired first, silently: it needs no firmware and no questions.
        for i in $(ifaces); do
            is_wifi "$i" && continue
            has_carrier "$i" || continue
            say "Trying $i..."
            if dhcp_on "$i" && online; then break; fi
        done
        online && continue

        wifis=$(for i in $(ifaces); do is_wifi "$i" && echo "$i"; done)
        wired=$(for i in $(ifaces); do is_wifi "$i" || echo "$i"; done)

        printf '\n'
        n=1
        if [ -n "$wifis" ]; then
            printf '   %s1%s  Connect to wifi\n' "$B" "$R"; n=2
        fi
        printf '   %s%d%s  Retry wired  %s(plug in ethernet, a USB-C adapter, or a\n' "$B" "$n" "$R" "$D"
        printf '        phone with USB tethering on -- none need firmware)%s\n' "$R"
        printf '   %s%d%s  Shell\n' "$B" "$((n+1))" "$R"
        printf '   %s%d%s  Reboot\n' "$B" "$((n+2))" "$R"
        printf '\n'
        if [ -z "$wifis" ] && [ -z "$wired" ]; then
            warn "No network interfaces at all -- this machine's driver may need"
            warn "firmware that is not in this image."
        fi
        ask "choice:"
        case "$REPLY" in
            1) if [ -n "$wifis" ]; then
                   dev=$(printf '%s\n' "$wifis" | head -1)
                   wifi_connect "$dev" || pause
               fi ;;
            2) [ -n "$wifis" ] || : ;;   # retry wired: the loop does it
            3) ${SHELL:-/bin/sh} || true ;;
            4) reboot ;;
            *) ;;
        esac
    done
}

# --------------------------------------------------------------------- disk
step_disk() {
    while :; do
        head "Step 2 of 3   Disk"
        say "NETHOS will be installed to one disk, erasing everything on it."
        printf '\n'
        disks=$(lsblk -dno NAME,SIZE,MODEL 2>/dev/null | grep -vE '^(loop|sr|ram)' || true)
        [ -n "$disks" ] || { warn "No disks found."; pause; return 1; }
        i=0
        printf '%s\n' "$disks" | while read -r line; do
            i=$((i+1)); printf '   %s%2d%s  /dev/%s\n' "$B" "$i" "$R" "$line"
        done
        printf '\n'
        ask "disk number (or r to reboot):"
        [ "$REPLY" = r ] && reboot
        line=$(printf '%s\n' "$disks" | sed -n "${REPLY}p" 2>/dev/null || true)
        [ -n "$line" ] || { warn "no such number"; pause; continue; }
        TARGET="/dev/$(printf '%s' "$line" | awk '{print $1}')"
        [ -b "$TARGET" ] || { warn "$TARGET is not a disk"; pause; continue; }
        return 0
    done
}

# ------------------------------------------------------------------ confirm
step_confirm() {
    head "Step 3 of 3   Confirm"
    warn "This erases $TARGET completely."
    printf '\n'
    say "Everything on it goes: partitions, filesystems, other operating"
    say "systems, all data. There is no undo."
    printf '\n'
    lsblk "$TARGET" 2>/dev/null | sed 's/^/    /'
    printf '\n'
    say "About 700MB is downloaded. On a slow connection this takes a while."
    printf '\n'
    ask "type ERASE to continue, anything else to go back:"
    [ "$REPLY" = "ERASE" ]
}

# --------------------------------------------------------------------- main
while :; do
    head "Installer"
    nethos-hwscan 2>/dev/null | sed 's/^/  /' || say "(hardware scan unavailable)"
    printf '\n'
    ask "press enter to begin, or s for a shell:"
    [ "$REPLY" = s ] && { ${SHELL:-/bin/sh} || true; continue; }

    step_network || continue
    step_disk    || continue
    step_confirm || continue

    head "Installing"
    say "Building NETHOS on $TARGET. Do not power off."
    printf '\n'
    if nethos-install --online --no-confirm --target "$TARGET"; then
        printf '\n'; ok "NETHOS is installed."
        say "Remove the installer and reboot."
        printf '\n'
        ask "reboot now? [Y/n]:"
        case "$REPLY" in [nN]*) ;; *) reboot ;; esac
    else
        printf '\n'; warn "The install did not finish."
        say "Nothing was written to the bootloader, so the disk is not"
        say "half-installed -- it is simply not installed."
        pause
    fi
done
