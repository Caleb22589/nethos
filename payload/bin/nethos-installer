#!/bin/sh
# The NETHOS installer: connect, choose a disk, install.
#
# A wizard, in that order, because that is the order the machine needs them in.
# The first version was a menu whose first item refused to run until you had
# used its second item, which is a puzzle rather than an installer.
#
# No NetworkManager. There is no systemd in this initramfs -- the installer is
# started directly by init -- so nmcli has no daemon to talk to and fails with
# "could not create NMClient". wpa_supplicant and udhcpc are driven here
# directly, which is fewer moving parts than a service manager anyway.
set -eu

# ----------------------------------------------------------------- looking
# right
#
# A console has sixteen colours and one font, and that is enough. docs/DESIGN.md
# rule 1 holds here as much as in the shell: one accent, and it marks the thing
# you would press -- the number you are about to type, and the step you are on.
# Everything else is the terminal default or dimmed. Status colours appear only
# when something has a status.
#
# The accent is #3b6ea5, a muted steel blue; bright blue is the closest a
# console gets. Rule 23 rules out anything more saturated -- a neon accent on a
# black console looks like a boot menu from 1998, which is precisely the
# impression an installer should not give.
ESC=$(printf '\033')
B="${ESC}[1m"; D="${ESC}[2m"; R="${ESC}[0m"
A="${ESC}[94m"; AB="${ESC}[1;94m"      # accent, and accent bold
GRN="${ESC}[32m"; RED="${ESC}[31m"; AMB="${ESC}[33m"

W=68                                    # content width, fits an 80-col console

rep()  { n=$1; c=$2; out=""; while [ "$n" -gt 0 ]; do out="$out$c"; n=$((n-1)); done; printf '%s' "$out"; }
line() { printf '  %s%s%s\n' "$D" "$(rep "$W" '─')" "$R"; }
gap()  { printf '\n'; }

# The wordmark and where you are in the sequence. Three steps, always all three
# shown: an installer that reveals its length one screen at a time feels longer
# than one that says up front there are three.
ui_head() {   # $1 title, $2 current step number (0 for none)
    clear 2>/dev/null || printf '\033[H\033[2J'
    gap
    printf '  %sNETHOS%s%s  %s%s\n' "$AB" "$R" "$D" "${1:-}" "$R"
    gap
    if [ "${2:-0}" != 0 ]; then
        i=1
        printf '  '
        for name in Network Disk Confirm; do
            [ "$i" = 1 ] || printf '%s  ·  %s' "$D" "$R"
            if [ "$i" -lt "${2}" ]; then   printf '%s%s%s' "$GRN" "$name" "$R"
            elif [ "$i" = "${2}" ]; then   printf '%s%s%s' "$AB" "$name" "$R"
            else                           printf '%s%s%s' "$D" "$name" "$R"
            fi
            i=$((i+1))
        done
        gap
    fi
    line
    gap
}

say()  { printf '  %s\n' "$*"; }
dim()  { printf '  %s%s%s\n' "$D" "$*" "$R"; }
warn() { printf '  %s%s%s\n' "$RED" "$*" "$R"; }
ok()   { printf '  %s%s%s\n' "$GRN" "$*" "$R"; }
note() { printf '  %s%s%s\n' "$AMB" "$*" "$R"; }

# The number is the accent because the number is what you press.
item() { printf '   %s%3s%s  %s\n' "$AB" "$1" "$R" "$2"; }
itemd(){ printf '   %s%3s%s  %-30.30s  %s%s%s\n' "$AB" "$1" "$R" "$2" "$D" "$3" "$R"; }

ask()  { gap; printf '  %s ' "$1"; read -r REPLY || REPLY=""; }
askpw() {
    gap; printf '  %s ' "$1"
    stty -echo 2>/dev/null || true
    read -r PW || PW=""
    stty echo 2>/dev/null || true
    gap
}
pause() { gap; printf '  %spress enter%s ' "$D" "$R"; read -r _ || true; }

[ "$(id -u)" = 0 ] || exec sudo -- "$0" "$@"

online() { ip route 2>/dev/null | grep -q '^default'; }
ifaces()  { ls /sys/class/net 2>/dev/null | grep -v '^lo$'; }
is_wifi() { [ -d "/sys/class/net/$1/wireless" ] || [ -e "/sys/class/net/$1/phy80211" ]; }
has_carrier() { [ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null || echo 0)" = 1 ]; }

dhcp_on() {
    ip link set "$1" up 2>/dev/null || true
    # busybox udhcpc first: it is always here and needs no lease database.
    if command -v udhcpc >/dev/null 2>&1; then
        udhcpc -i "$1" -n -q -t 8 -T 2 >/tmp/dhcp.log 2>&1 && ip route 2>/dev/null | grep -q '^default' && return 0
        # A lease with no route is worth one more try with the script named
        # explicitly, in case the built-in path is not where Debian put it.
        [ -x /usr/share/udhcpc/default.script ] && \
            udhcpc -i "$1" -n -q -t 4 -T 2 -s /usr/share/udhcpc/default.script \
                >>/tmp/dhcp.log 2>&1 && ip route 2>/dev/null | grep -q '^default' && return 0
    fi
    command -v dhclient >/dev/null 2>&1 && dhclient -1 -timeout 15 "$1" >/dev/null 2>&1 && return 0
    return 1
}

# ------------------------------------------------------------------ network
# Bring an interface up and wait for it, rather than assuming it worked.
#
# ip link set up was called with its error thrown away, and iw then reported
# "command failed: Network is down (-100)" -- which reads as a scan problem
# and is actually the interface never having come up. A wifi driver loads its
# firmware when the interface is brought up, so this can take a moment after
# the device appears, and failing once means nothing.
bring_up() {   # $1 interface
    command -v rfkill >/dev/null 2>&1 && rfkill unblock all 2>/dev/null || true
    n=0
    while [ "$n" -lt 10 ]; do
        ip link set "$1" up 2>/tmp/link.err && \
            grep -q up "/sys/class/net/$1/operstate" 2>/dev/null && return 0
        # "up" in flags is enough; operstate stays "down" until associated.
        ip link show "$1" 2>/dev/null | head -1 | grep -q "[<,]UP[,>]" && return 0
        n=$((n + 1)); sleep 1
    done
    return 1
}

wifi_connect() {   # $1 interface
    dev=$1
    ui_head "Wifi" 1
    say "Bringing $dev up..."
    if ! bring_up "$dev"; then
        warn "$dev will not come up."
        gap
        [ -s /tmp/link.err ] && { dim "ip said:"; sed 's/^/    /' /tmp/link.err | head -2; gap; }
        dmesg 2>/dev/null | grep -iE "$dev|rtw|iwl|ath|brcm" | tail -4 | sed 's/^/    /'
        gap
        dim "A wifi driver loads its firmware when the interface comes up, so"
        dim "this is usually firmware this image does not carry. Ethernet or a"
        dim "phone over USB needs none."
        return 1
    fi
    say "Scanning on $dev..."
    # One network per line as "signal<TAB>ssid", strongest first.
    #
    # The SSID is everything after "SSID: " -- it can contain spaces, so it
    # cannot be a field. Taking $2 lost half of them and leaving awk to rebuild
    # $0 left a leading space on the rest, which then reached wpa_supplicant as
    # part of the name and matched nothing.
    # Patterns are unanchored on purpose. Anchoring them to a leading tab
    # broke a scan that worked: iw's indentation is not something to depend on,
    # and a parser that silently yields nothing looks exactly like a radio that
    # found nothing.
    # Scan more than once. A radio brought up a second ago routinely returns an
    # empty first result, and reporting "no networks found" for that sends
    # somebody looking for a firmware problem they do not have.
    try=1
    while [ "$try" -le 3 ]; do
        iw dev "$dev" scan > /tmp/scan.raw 2>/tmp/scan.err || true
        grep -q "SSID:" /tmp/scan.raw 2>/dev/null && break
        [ "$try" -lt 3 ] && { printf '  %sscanning (%d)...%s\n' "$D" "$try" "$R"; sleep 2; }
        try=$((try + 1))
    done
    scan=$(awk '
        /signal:/ { sig = $2 }
        /SSID:/   {
            i = index($0, "SSID:")
            ssid = substr($0, i + 5)
            sub(/^[ \t]+/, "", ssid)
            gsub(/[^[:print:]]/, "", ssid)
            if (ssid != "" && !(ssid in seen)) { seen[ssid] = 1; printf "%d\t%s\n", sig, ssid }
        }' /tmp/scan.raw | sort -rn | head -15)

    if [ -z "$scan" ]; then
        warn "No networks found on $dev."
        gap
        # Three different faults look identical from here, so show which.
        if [ -s /tmp/scan.err ]; then
            dim "iw said:"; sed 's/^/    /' /tmp/scan.err | head -3
            gap
        fi
        if command -v rfkill >/dev/null 2>&1 && rfkill list 2>/dev/null | grep -qi 'yes'; then
            note "The radio is blocked -- try the wifi key or switch on this laptop."
            rfkill list 2>/dev/null | sed 's/^/    /' | head -6
            gap
        fi
        fw=$(dmesg 2>/dev/null | grep -icE "$dev|firmware.*(fail|not found)" || echo 0)
        if dmesg 2>/dev/null | grep -qiE "firmware.*(fail|missing|not found)"; then
            note "The kernel could not load some firmware:"
            dmesg 2>/dev/null | grep -iE "firmware.*(fail|missing|not found)" \
                | tail -3 | sed 's/^/    /'
            gap
            dim "This 98MB image carries firmware for common chips, not all of"
            dim "them. Ethernet or a phone over USB needs none at all."
        else
            dim "The driver is loaded and the scan returned nothing. If there are"
            dim "networks in range, try again -- a radio that has just come up"
            dim "sometimes reports an empty first scan."
        fi
        return 1
    fi

    printf '\n'
    # Numbered into a file: a pipeline runs the loop in a subshell, so the
    # counter it increments is gone by the time the list is read back.
    printf '%s\n' "$scan" | nl -w3 -s'  ' > /tmp/wifi.list
    while IFS= read -r line; do
        num=$(printf '%s' "$line" | awk '{print $1}')
        sig=$(printf '%s' "$line" | cut -f1 | awk '{print $2}')
        ssid=$(printf '%s' "$line" | cut -f2-)
        printf '   %s%3s%s  %-30.30s  %5s dBm\n' "$B" "$num" "$R" "$ssid" "$sig"
    done < /tmp/wifi.list
    printf '\n'

    ask "network number (or blank to go back):"
    [ -n "$REPLY" ] || return 1
    case "$REPLY" in *[!0-9]*) warn "not a number"; return 1 ;; esac
    ssid=$(sed -n "${REPLY}p" /tmp/wifi.list 2>/dev/null | cut -f2-)
    [ -n "$ssid" ] || { warn "no such number"; return 1; }

    askpw "password for \"$ssid\" (blank if the network is open):"

    conf=/tmp/wpa.conf
    if [ -z "$PW" ]; then
        printf 'network={\n  ssid="%s"\n  key_mgmt=NONE\n}\n' "$ssid" > "$conf"
    else
        # Written straight in rather than run through wpa_passphrase.
        # wpa_supplicant takes a plaintext psk, so the hashing step is one more
        # program to be missing -- and when it was, the failure was reported as
        # "password must be 8-63 characters", which blamed the password for a
        # command that was not there.
        len=$(printf '%s' "$PW" | wc -c | tr -d ' ')
        if [ "$len" -lt 8 ] || [ "$len" -gt 63 ]; then
            warn "a WPA password is 8 to 63 characters; that one is $len"
            return 1
        fi
        printf 'network={\n  ssid="%s"\n  psk="%s"\n}\n' "$ssid" "$PW" > "$conf"
    fi
    chmod 600 "$conf"

    pkill wpa_supplicant 2>/dev/null || true
    say "Connecting to $ssid..."
    if ! wpa_supplicant -B -i "$dev" -c "$conf" >/tmp/wpa.log 2>&1; then
        warn "wpa_supplicant would not start:"
        tail -3 /tmp/wpa.log 2>/dev/null | sed 's/^/    /'
        return 1
    fi
    n=0
    while [ $n -lt 20 ]; do
        iw dev "$dev" link 2>/dev/null | grep -q "Connected to" && break
        n=$((n + 1)); sleep 1
    done
    if ! iw dev "$dev" link 2>/dev/null | grep -q "Connected to"; then
        warn "could not associate with $ssid -- wrong password, or out of range"
        return 1
    fi
    say "Associated. Getting an address..."
    if ! dhcp_on "$dev"; then
        warn "Associated with $ssid, but DHCP gave no address."
        gap
        [ -s /tmp/dhcp.log ] && { dim "udhcpc said:"; tail -4 /tmp/dhcp.log | sed 's/^/    /'; gap; }
        ip -br addr show "$dev" 2>/dev/null | sed 's/^/    /'
        return 1
    fi
    if ! online; then
        # An address without a route is the DHCP script half-working, and
        # returning quietly here sent you back to the menu with no reason given.
        warn "Got an address on $dev but no default route."
        gap
        ip -br addr show "$dev" 2>/dev/null | sed 's/^/    /'
        ip route 2>/dev/null | sed 's/^/    /'
        [ -s /tmp/dhcp.log ] && { gap; dim "udhcpc said:"; tail -4 /tmp/dhcp.log | sed 's/^/    /'; }
        return 1
    fi
    ok "Connected to $ssid."
    return 0
}

step_network() {
    while :; do
        ui_head "Installer" 1
        if online; then
            ok "Connected"
            gap
            ip -br addr 2>/dev/null | grep -v '^lo' \
                | awk '{printf "    %-10s %s\n", $1, $3}'
            gap
            dim "NETHOS is downloaded during the install -- about 700MB."
            pause
            return 0
        fi

        say "NETHOS is downloaded during the install, so it needs a connection."
        gap

        # Wired first, silently: it needs no firmware and no questions.
        for i in $(ifaces); do
            is_wifi "$i" && continue
            has_carrier "$i" || continue
            say "Trying $i..."
            if dhcp_on "$i" && online; then break; fi
        done
        online && continue

        wifis=$(for i in $(ifaces); do is_wifi "$i" && echo "$i"; done)
        wired=$(for i in $(ifaces); do is_wifi "$i" || echo "$i"; done)

        gap
        [ -n "$wifis" ] && item 1 "Connect to wifi"
        item 2 "Retry wired"
        dim "        ethernet, a USB-C adapter, or a phone with USB"
        dim "        tethering switched on -- none of these need firmware"
        item 3 "Shell"
        item 4 "Reboot"
        if [ -z "$wifis" ] && [ -z "$wired" ]; then
            gap
            warn "No network interfaces at all."
            dim "This machine's network driver may need firmware that is not"
            dim "in this 98MB image."
        fi
        ask "choice:"
        case "$REPLY" in
            1) if [ -n "$wifis" ]; then
                   dev=$(printf '%s\n' "$wifis" | head -1)
                   wifi_connect "$dev" || pause
               fi ;;
            2) [ -n "$wifis" ] || : ;;   # retry wired: the loop does it
            3) ${SHELL:-/bin/sh} || true ;;
            4) reboot ;;
            *) ;;
        esac
    done
}

# --------------------------------------------------------------------- disk
step_disk() {
    while :; do
        ui_head "Installer" 2
        say "Choose the disk to install to. Everything on it is erased."
        gap
        lsblk -dno NAME,SIZE,MODEL 2>/dev/null | grep -vE '^(loop|sr|ram)' \
            | nl -w3 -s'  ' > /tmp/disk.list || true
        [ -s /tmp/disk.list ] || { warn "No disks found."; pause; return 1; }
        # Printed from the same file the selection is read from. They were two
        # different things: the list came from a variable and the choice was
        # looked up in a file nothing had written, so every number was refused.
        while IFS= read -r l; do
            num=$(printf '%s' "$l" | awk '{print $1}')
            dev=$(printf '%s' "$l" | awk '{print $2}')
            sz=$(printf  '%s' "$l" | awk '{print $3}')
            model=$(printf '%s' "$l" | awk '{$1=""; $2=""; $3=""; sub(/^ +/,""); print}')
            itemd "$num" "/dev/$dev   $sz" "$model"
        done < /tmp/disk.list
        ask "disk number (or r to reboot):"
        [ "$REPLY" = r ] && reboot
        case "$REPLY" in ''|*[!0-9]*) warn "not a number"; pause; continue ;; esac
        row=$(sed -n "${REPLY}p" /tmp/disk.list 2>/dev/null || true)
        [ -n "$row" ] || { warn "no such number"; pause; continue; }
        TARGET="/dev/$(printf '%s' "$row" | awk '{print $2}')"
        [ -b "$TARGET" ] || { warn "$TARGET is not a disk"; pause; continue; }
        return 0
    done
}

# ------------------------------------------------------------------ confirm
step_confirm() {
    ui_head "Installer" 3
    warn "$TARGET will be erased completely."
    gap
    dim "Partitions, filesystems, other operating systems, all data."
    dim "There is no undo."
    gap
    lsblk -o NAME,SIZE,FSTYPE,LABEL "$TARGET" 2>/dev/null | sed 's/^/    /'
    gap
    line
    dim "About 700MB is downloaded. On a slow link this takes a while."
    ask "type ERASE to continue, anything else to go back:"
    [ "$REPLY" = "ERASE" ]
}

# --------------------------------------------------------------------- main
while :; do
    ui_head "Install to this machine" 0
    nethos-hwscan 2>/dev/null | sed 's/^/  /' || say "(hardware scan unavailable)"
    gap
    line
    ask "press enter to begin, or s for a shell:"
    [ "$REPLY" = s ] && { ${SHELL:-/bin/sh} || true; continue; }

    step_network || continue
    step_disk    || continue
    step_confirm || continue

    ui_head "Installing" 3
    say "Building NETHOS on $TARGET."
    dim "Do not power the machine off."
    gap
    line
    gap
    if nethos-install --online --no-confirm --target "$TARGET"; then
        gap; line; gap
        ok "NETHOS is installed."
        dim "Remove the installer stick, then reboot."
        gap
        ask "reboot now? [Y/n]:"
        case "$REPLY" in [nN]*) ;; *) reboot ;; esac
    else
        gap; line; gap
        warn "The install did not finish."
        dim "Nothing was written to the bootloader, so the disk is not"
        dim "half-installed -- it is simply not installed."
        pause
    fi
done
