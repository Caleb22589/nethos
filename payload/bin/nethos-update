#!/bin/bash
# Update NETHOS from its git repository, in place, without rebuilding the VM.
#
#   nethos-update                pull the configured branch and apply
#   nethos-update --ref v2       pull a specific branch/tag/commit
#   nethos-update --packages     also run the pacman package step
#   nethos-update --status       show what is installed vs available
#   nethos-update --local DIR    apply from a local checkout instead of git
#
# Run as your normal user (it will ask for sudo only for the install step).
set -euo pipefail

CONF=/etc/nethos/update.conf
[ -r "$CONF" ] && . "$CONF"

REPO_URL="${REPO_URL:-}"
BRANCH="${BRANCH:-main}"
REPO_DIR="${REPO_DIR:-$HOME/.local/share/nethos/repo}"

REF=""
PACKAGES=0
LOCAL=""
STATUS=0

while [ $# -gt 0 ]; do
    case "$1" in
        --ref) REF="${2:?--ref needs a value}"; shift 2 ;;
        --packages) PACKAGES=1; shift ;;
        --local) LOCAL="${2:?--local needs a directory}"; shift 2 ;;
        --status) STATUS=1; shift ;;
        -h|--help) sed -n '2,11p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m warn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "run this as your normal user, not root (it sudos when needed)"

# --------------------------------------------------------------------------
# fetch
# --------------------------------------------------------------------------
if [ -n "$LOCAL" ]; then
    SRC="$(cd "$LOCAL" && pwd)"
    say "Applying from local checkout: $SRC"
else
    [ -n "$REPO_URL" ] || die "no REPO_URL configured. Edit $CONF or use --local DIR"
    TARGET="${REF:-$BRANCH}"

    if [ -d "$REPO_DIR/.git" ]; then
        say "Fetching $TARGET from $REPO_URL"
        git -C "$REPO_DIR" remote set-url origin "$REPO_URL"
        git -C "$REPO_DIR" fetch --tags --prune origin
    else
        say "Cloning $REPO_URL"
        mkdir -p "$(dirname "$REPO_DIR")"
        git clone "$REPO_URL" "$REPO_DIR"
        git -C "$REPO_DIR" fetch --tags --prune origin
    fi

    # Prefer the remote branch when the ref names one, else take it literally
    # (a tag or a commit), so --ref works for all three without extra flags.
    if git -C "$REPO_DIR" rev-parse --verify --quiet "origin/$TARGET" >/dev/null; then
        RESOLVED="origin/$TARGET"
    elif git -C "$REPO_DIR" rev-parse --verify --quiet "$TARGET" >/dev/null; then
        RESOLVED="$TARGET"
    else
        die "ref not found in repository: $TARGET"
    fi

    git -C "$REPO_DIR" checkout --quiet --detach "$RESOLVED"
    SRC="$REPO_DIR"
fi

[ -x "$SRC/payload/install-nethos.sh" ] || die "not a NETHOS repository: $SRC"

INSTALLED="$(cat /etc/nethos-release 2>/dev/null || echo unknown)"
AVAILABLE="$(git -C "$SRC" log -1 --format='%h %cs %s' 2>/dev/null || echo 'local checkout')"

if [ "$STATUS" -eq 1 ]; then
    printf 'installed build : %s\n' "$INSTALLED"
    printf 'source          : %s\n' "$SRC"
    printf 'available       : %s\n' "$AVAILABLE"
    exit 0
fi

say "Installed build : $INSTALLED"
say "Applying        : $AVAILABLE"

# --------------------------------------------------------------------------
# apply
# --------------------------------------------------------------------------
INSTALL_ARGS=(--files-only)

# --slot: apply the update to the slot we are not running from, then boot it.
#
# This is what the two partitions are for. In place, an update that breaks the
# desktop breaks the machine you would fix it with, and cannot touch anything
# that is in use -- the kernel, libc, systemd, which are exactly the updates
# most likely to go wrong. Into a slot, the running system is untouched: if
# the new one does not come up, the bootloader spends its three attempts and
# returns here.
#
# Not the default. It costs a full copy and a reboot where an in-place update
# costs seconds, and during active development the fast loop is worth more
# than atomicity. docs/ABUPDATE.md has the argument in full.
USE_SLOT=0
for a in "$@"; do [ "$a" = "--slot" ] && USE_SLOT=1; done

if [ "$USE_SLOT" = 1 ]; then
    command -v nethos-ab >/dev/null 2>&1 || die "nethos-ab is not installed"
    [ -f /etc/nethos/slots.conf ] || die "this system has no A/B layout -- see nethos-install --layout ab"
fi
[ "$PACKAGES" -eq 1 ] && INSTALL_ARGS=()

# A snapshot before every update, so a bad one is a command away from undone
# rather than a rebuild away. This is the whole reason the snapshot tool
# exists: an update that leaves the desktop broken is the failure that
# actually happens, and it happens while the system underneath is fine.
if command -v nethos-snapshot >/dev/null 2>&1; then
    say "Snapshotting the current install first"
    SNAP_ID="$(sudo nethos-snapshot create "pre-update" | tail -1 || true)"
    [ -n "${SNAP_ID:-}" ] && say "  roll back with: sudo nethos-snapshot restore $SNAP_ID"
fi

say "Installing system files (sudo)"
if [ "$USE_SLOT" = 1 ]; then
    # Copy first, then update the copy. The order matters: updating the
    # running system and then copying it would put the new system in both
    # slots and leave nothing to fall back to.
    say "Filling the idle slot from the running system"
    sudo nethos-ab sync >/dev/null || die "could not fill the idle slot"

    IDLE_DEV=$(sudo nethos-ab status | awk '/^idle slot/{print $NF}' | tr -d '()')
    MNT=$(mktemp -d)
    sudo mount "$IDLE_DEV" "$MNT" || die "could not mount the idle slot"

    # Run the installer *inside* the slot rather than teaching it about a root
    # prefix: every path it writes is then correct by construction, and there
    # is no second code path to keep in step with the first.
    #
    # /home is bind-mounted because the repository lives there and the slot
    # does not have one -- /home is shared and deliberately outside both
    # slots. The rest are what a chroot needs to run anything at all.
    say "Applying the update inside it"
    for d in /dev /dev/pts /proc /sys /run /home; do
        sudo mkdir -p "$MNT$d"
        sudo mount --rbind "$d" "$MNT$d"
        sudo mount --make-rslave "$MNT$d" 2>/dev/null || true
    done
    [ -e /etc/resolv.conf ] && sudo cp -L /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true

    if ! sudo chroot "$MNT" "$SRC/payload/install-nethos.sh" --files-only; then
        sudo umount -R "$MNT" 2>/dev/null || sudo umount -Rl "$MNT" 2>/dev/null || true
        rmdir "$MNT" 2>/dev/null || true
        die "the update failed inside the idle slot -- the running system is untouched"
    fi
    sudo umount -R "$MNT" 2>/dev/null || sudo umount -Rl "$MNT" 2>/dev/null || true
    rmdir "$MNT" 2>/dev/null || true

    sudo nethos-ab switch
    say "Done. Reboot to run it; if it does not come up you land back here."
    exit 0
fi

if ! sudo "$SRC/payload/install-nethos.sh" "${INSTALL_ARGS[@]}"; then
    warn "the update failed part way through"
    if [ -n "${SNAP_ID:-}" ]; then
        # Half an update is worse than none: some files new, some old, and no
        # way to tell which. Put it back rather than leaving that behind.
        warn "restoring $SNAP_ID"
        sudo nethos-snapshot restore "$SNAP_ID" || \
            die "restore failed too -- snapshots are in /var/lib/nethos/snapshots"
        die "update rolled back; nothing changed"
    fi
    die "update failed and there was no snapshot to roll back to"
fi

# --------------------------------------------------------------------------
# apply live
# --------------------------------------------------------------------------
if systemctl --user is-active --quiet nethosd 2>/dev/null; then
    say "Restarting nethosd and reloading every open window"
    nethos-reload --daemon
    # The sway config is part of the payload, so a pulled change to keybindings
    # or window rules is on disk but not in effect until the compositor rereads
    # it. Without this an update looks like it did nothing.
    if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_version >/dev/null 2>&1; then
        swaymsg reload >/dev/null 2>&1 && say "compositor config reloaded" || true
    fi
else
    warn "nethosd is not running under this user session"
    warn "log in at the desktop, or run: systemctl --user start nethosd"
fi

say "NETHOS updated. No reboot required."
